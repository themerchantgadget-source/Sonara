
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#111111">
<title>Media — Player</title>

<style>
:root {
  color-scheme: dark;
  --bg:#111111;
  --surface:#1c1c1e;
  --surface2:#272729;
  --surface3:#333336;
  --text:#f5f5f5;
  --muted:#99999f;
  --border:rgba(255,255,255,.09);
  --accent:#d9d9d9;
  --panel:#080808;
  --radius:20px;
}

[data-theme="light"] {
  color-scheme:light;
  --bg:#f2f2f0;
  --surface:#ffffff;
  --surface2:#eaeae8;
  --surface3:#dededb;
  --text:#171717;
  --muted:#777773;
  --border:rgba(0,0,0,.09);
  --accent:#222222;
  --panel:#f8f8f6;
}

* {
  box-sizing:border-box;
  margin:0;
  padding:0;
  -webkit-tap-highlight-color:transparent;
}

html,body {
  width:100%;
  height:100%;
  overflow:hidden;
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",
  "Segoe UI",sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input {
  font:inherit;
}

button {
  border:0;
  color:inherit;
  cursor:pointer;
}

#app {
  height:100dvh;
  width:100%;
  position:relative;
  overflow:hidden;
  background:var(--bg);
}

/* HOME */

.home {
  position:absolute;
  inset:0;
  z-index:2;
  display:flex;
  flex-direction:column;
  padding:
    calc(env(safe-area-inset-top) + 25px)
    24px
    calc(env(safe-area-inset-bottom) + 24px);
  background:var(--bg);
  transition:transform .4s cubic-bezier(.2,.8,.2,1);
}

.home.hidden {
  transform:translateX(-105%);
}

.home-header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:48px;
}

.brand {
  font-size:23px;
  font-weight:650;
  letter-spacing:-1.1px;
}

.brand span {
  color:var(--muted);
  font-weight:400;
}

.icon-button {
  width:44px;
  height:44px;
  display:grid;
  place-items:center;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:50%;
  color:var(--text);
}

.icon-button svg {
  width:20px;
  height:20px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.7;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.home-intro {
  margin-bottom:28px;
}

.eyebrow {
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:2px;
  font-size:10px;
  font-weight:650;
  margin-bottom:12px;
}

.home-intro h1 {
  font-size:38px;
  letter-spacing:-2px;
  font-weight:550;
  line-height:1.12;
}

.home-intro p {
  color:var(--muted);
  margin-top:12px;
  font-size:13px;
}

.media-options {
  display:flex;
  flex-direction:column;
  gap:14px;
}

.media-card {
  position:relative;
  height:180px;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:25px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  padding:22px;
  text-align:left;
  transition:transform .2s;
}

.media-card:active {
  transform:scale(.98);
}

.media-card .card-symbol {
  position:absolute;
  right:22px;
  top:22px;
  width:66px;
  height:66px;
  border-radius:20px;
  display:grid;
  place-items:center;
  background:var(--surface2);
}

.card-symbol svg {
  width:30px;
  height:30px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.4;
}

.media-card h2 {
  font-size:26px;
  letter-spacing:-1px;
  font-weight:550;
}

.media-card p {
  color:var(--muted);
  font-size:12px;
  margin-top:5px;
}

.home-footer {
  margin-top:auto;
  padding-top:30px;
  color:var(--muted);
  font-size:11px;
}

/* WORKSPACE */

.workspace {
  position:absolute;
  inset:0;
  z-index:3;
  background:var(--bg);
  display:flex;
  flex-direction:column;
  transform:translateX(105%);
  transition:transform .4s cubic-bezier(.2,.8,.2,1);
}

.workspace.active {
  transform:translateX(0);
}

.topbar {
  height:75px;
  min-height:75px;
  padding:calc(env(safe-area-inset-top) + 8px) 19px 8px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:var(--bg);
  z-index:5;
}

.topbar-title {
  font-size:18px;
  font-weight:600;
  letter-spacing:-.5px;
}

.topbar-actions {
  display:flex;
  align-items:center;
  gap:9px;
}

.workspace-body {
  flex:1;
  min-height:0;
  position:relative;
  overflow:hidden;
}

.player-layout {
  height:100%;
  display:flex;
  flex-direction:column;
  overflow-y:auto;
  scrollbar-width:none;
  padding:12px 20px 25px;
}

.player-layout::-webkit-scrollbar {
  display:none;
}

/* PLAYER */

.player-stage {
  background:#858585;
  border-radius:24px;
  width:100%;
  aspect-ratio:1.15;
  max-height:390px;
  min-height:220px;
  position:relative;
  overflow:hidden;
  display:flex;
  justify-content:center;
  align-items:center;
  flex-shrink:0;
}

.video-element {
  width:100%;
  height:100%;
  object-fit:contain;
  background:#858585;
  display:none;
}

.video-element.visible {
  display:block;
}

.video-placeholder {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
  color:#fff;
}

.video-placeholder svg {
  width:50px;
  height:50px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.2;
}

.video-placeholder span {
  font-size:12px;
  opacity:.8;
}

.video-overlay {
  position:absolute;
  inset:auto 0 0;
  padding:45px 16px 15px;
  background:linear-gradient(transparent,rgba(0,0,0,.8));
  color:white;
  display:none;
}

.video-overlay.visible {
  display:block;
}

.video-controls {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:12px;
}

.video-controls button {
  background:transparent;
  color:white;
  font-size:12px;
}

.video-controls svg {
  width:21px;
  height:21px;
  stroke:currentColor;
  fill:none;
  stroke-width:2;
}

.video-progress {
  width:100%;
  height:4px;
  accent-color:white;
  cursor:pointer;
}

.video-time {
  font-size:10px;
  color:#ddd;
  margin-top:7px;
}

/* MUSIC ARTWORK */

.music-artwork {
  width:100%;
  height:100%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:linear-gradient(145deg,#414144,#161616);
  position:absolute;
  inset:0;
  transition:background .3s;
}

.music-artwork img {
  width:100%;
  height:100%;
  object-fit:cover;
}

.artwork-placeholder {
  width:125px;
  height:125px;
  border-radius:25px;
  background:rgba(255,255,255,.08);
  display:grid;
  place-items:center;
  color:white;
}

.artwork-placeholder svg {
  width:48px;
  height:48px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.2;
}

.music-artwork.hidden {
  display:none;
}

/* TRACK INFO */

.track-info {
  padding:23px 3px 15px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.track-info h2 {
  font-size:20px;
  font-weight:600;
  letter-spacing:-.7px;
  overflow:hidden;
  white-space:nowrap;
  text-overflow:ellipsis;
}

.track-info p {
  color:var(--muted);
  font-size:12px;
  margin-top:5px;
}

.track-info .track-type {
  background:var(--surface2);
  border-radius:20px;
  padding:7px 11px;
  font-size:10px;
  color:var(--muted);
}

.audio-element {
  display:none;
}

.progress-wrap {
  padding:5px 2px;
}

input[type=range] {
  accent-color:var(--text);
  width:100%;
  cursor:pointer;
}

.time-row {
  display:flex;
  justify-content:space-between;
  color:var(--muted);
  font-size:10px;
  margin-top:6px;
}

.music-controls {
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:17px 6px 24px;
}

.music-controls button {
  background:transparent;
  display:grid;
  place-items:center;
  color:var(--text);
}

.music-controls svg {
  width:23px;
  height:23px;
  stroke:currentColor;
  fill:none;
  stroke-width:1.8;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.music-controls .play-button {
  width:62px;
  height:62px;
  border-radius:50%;
  background:var(--text);
  color:var(--bg);
}

.play-button svg {
  width:26px;
  height:26px;
  fill:currentColor;
  stroke:none;
}

/* PLAYER TOOLS */

.tools {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  padding-bottom:20px;
}

.tool-button {
  padding:15px;
  border-radius:15px;
  background:var(--surface);
  border:1px solid var(--border);
  text-align:left;
  display:flex;
  align-items:center;
  justify-content:space-between;
  font-size:12px;
}

.tool-button span {
  color:var(--muted);
}

.tool-button svg {
  width:19px;
  height:19px;
  fill:none;
  stroke:currentColor;
  stroke-width:1.7;
}

/* MUSIC LIBRARY PANEL */

.library-panel {
  position:absolute;
  top:0;
  left:0;
  bottom:0;
  width:min(82%,350px);
  z-index:8;
  background:var(--panel);
  border-right:1px solid var(--border);
  padding:24px 17px calc(env(safe-area-inset-bottom) + 20px);
  display:flex;
  flex-direction:column;
  transform:translateX(-105%);
  transition:transform .35s cubic-bezier(.2,.8,.2,1);
}

.library-panel.open {
  transform:translateX(0);
}

.library-heading {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:24px;
}

.library-heading h2 {
  font-size:21px;
  font-weight:600;
  letter-spacing:-.7px;
}

.library-heading button {
  background:var(--surface2);
  width:36px;
  height:36px;
  border-radius:50%;
}

.library-heading svg {
  width:17px;
  height:17px;
  stroke:currentColor;
  fill:none;
}

.library-search {
  display:flex;
  align-items:center;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:13px;
  padding:0 12px;
  margin-bottom:18px;
  height:44px;
  gap:9px;
}

.library-search svg {
  width:18px;
  height:18px;
  stroke:var(--muted);
  fill:none;
}

.library-search input {
  border:0;
  outline:none;
  background:transparent;
  color:var(--text);
  width:100%;
  font-size:13px;
}

.library-tabs {
  display:flex;
  gap:8px;
  margin-bottom:15px;
}

.library-tabs button {
  padding:8px 14px;
  border-radius:30px;
  background:var(--surface2);
  color:var(--muted);
  font-size:11px;
}

.library-tabs button.active {
  background:var(--text);
  color:var(--bg);
}

.library-content {
  flex:1;
  overflow-y:auto;
  min-height:0;
}

.media-list {
  display:flex;
  flex-direction:column;
  gap:8px;
}

.media-item {
  display:flex;
  align-items:center;
  gap:12px;
  padding:10px;
  border-radius:14px;
  background:var(--surface);
  text-align:left;
  width:100%;
  min-width:0;
}

.media-item:active {
  background:var(--surface3);
}

.media-thumb {
  width:48px;
  height:48px;
  flex-shrink:0;
  border-radius:10px;
  background:var(--surface3);
  display:grid;
  place-items:center;
  overflow:hidden;
}

.media-thumb img {
  width:100%;
  height:100%;
  object-fit:cover;
}

.media-thumb svg {
  width:21px;
  height:21px;
  stroke:var(--muted);
  fill:none;
}

.media-item-info {
  flex:1;
  min-width:0;
}

.media-item-info strong {
  display:block;
  font-size:12px;
  font-weight:550;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.media-item-info small {
  color:var(--muted);
  font-size:10px;
  margin-top:5px;
  display:block;
}

.media-item .more {
  color:var(--muted);
  font-size:17px;
}

.hero-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:11px;
}

.hero-item {
  background:var(--surface);
  border-radius:15px;
  overflow:hidden;
  text-align:left;
}

.hero-thumb {
  height:115px;
  background:var(--surface2);
  display:grid;
  place-items:center;
  overflow:hidden;
}

.hero-thumb img {
  width:100%;
  height:100%;
  object-fit:cover;
}

.hero-thumb svg {
  width:30px;
  height:30px;
  stroke:var(--muted);
  fill:none;
}

.hero-info {
  padding:10px;
  min-width:0;
}

.hero-info strong {
  display:block;
  font-size:11px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.hero-info small {
  display:block;
  font-size:10px;
  color:var(--muted);
  margin-top:4px;
}

.library-bottom {
  display:flex;
  gap:9px;
  padding-top:15px;
}

.add-media {
  flex:1;
  height:47px;
  background:var(--text);
  color:var(--bg);
  border-radius:13px;
  font-size:12px;
  font-weight:600;
}

.add-folder {
  width:47px;
  height:47px;
  border-radius:13px;
  background:var(--surface2);
}

.add-folder svg {
  width:20px;
  height:20px;
  stroke:currentColor;
  fill:none;
}

/* OVERLAY */

.panel-overlay {
  position:absolute;
  inset:0;
  z-index:7;
  background:rgba(0,0,0,.45);
  opacity:0;
  pointer-events:none;
  transition:opacity .3s;
}

.panel-overlay.visible {
  opacity:1;
  pointer-events:auto;
}

/* MODALS */

.modal {
  position:absolute;
  inset:0;
  z-index:15;
  background:rgba(0,0,0,.6);
  display:none;
  align-items:flex-end;
  justify-content:center;
}

.modal.open {
  display:flex;
}

.modal-sheet {
  width:100%;
  max-height:85%;
  overflow-y:auto;
  background:var(--surface);
  border-radius:25px 25px 0 0;
  padding:25px 22px calc(env(safe-area-inset-bottom) + 25px);
}

.modal-header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:24px;
}

.modal-header h2 {
  font-size:20px;
  letter-spacing:-.7px;
}

.close-modal {
  width:35px;
  height:35px;
  background:var(--surface2);
  border-radius:50%;
}

.close-modal svg {
  width:16px;
  height:16px;
  stroke:currentColor;
  fill:none;
}

.equalizer {
  display:flex;
  justify-content:space-between;
  gap:8px;
  padding:20px 0;
}

.eq-band {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:15px;
  flex:1;
}

.eq-band input {
  appearance:slider-vertical;
  writing-mode:vertical-lr;
  direction:rtl;
  width:22px;
  height:135px;
}

.eq-band span {
  font-size:9px;
  color:var(--muted);
}

.preset-row {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.preset-row button {
  padding:9px 13px;
  border-radius:20px;
  background:var(--surface2);
  font-size:11px;
}

.lyrics-box {
  white-space:pre-wrap;
  font-size:15px;
  line-height:2;
  color:var(--muted);
  max-height:48vh;
  overflow-y:auto;
  text-align:center;
}

.lyrics-box .current-line {
  color:var(--text);
  font-size:19px;
  font-weight:650;
}

.lyrics-input {
  width:100%;
  height:110px;
  background:var(--surface2);
  border:1px solid var(--border);
  border-radius:13px;
  padding:12px;
  color:var(--text);
  resize:vertical;
  outline:none;
  margin-top:15px;
}

.modal-action {
  width:100%;
  padding:14px;
  margin-top:14px;
  border-radius:13px;
  background:var(--text);
  color:var(--bg);
  font-weight:600;
}

/* EMPTY STATE */

.empty-state {
  padding:40px 12px;
  text-align:center;
  color:var(--muted);
}

.empty-state svg {
  width:34px;
  height:34px;
  stroke:currentColor;
  fill:none;
  margin-bottom:12px;
}

.empty-state strong {
  display:block;
  color:var(--text);
  font-size:13px;
  margin-bottom:7px;
}

.empty-state p {
  font-size:11px;
  line-height:1.6;
}

.hidden-input {
  display:none;
}

@media (min-width:700px) {
  .home {
    max-width:550px;
    margin:auto;
    left:50%;
    transform:translateX(-50%);
  }
  .home.hidden {
    transform:translate(-160%,-0%);
  }
  .workspace {
    max-width:600px;
    left:50%;
    transform:translate(100%,0);
    margin-left:-300px;
    border-left:1px solid var(--border);
    border-right:1px solid var(--border);
  }
  .workspace.active {
    transform:translate(0,0);
  }
}
</style>
</head>

<body>
<div id="app">

<!-- HOME -->
<section class="home" id="home">

  <header class="home-header">
    <div class="brand">media<span>.</span></div>
    <button class="icon-button" id="appearanceToggle" aria-label="Toggle appearance">
      <svg id="appearanceIcon" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/>
      </svg>
    </button>
  </header>

  <div class="home-intro">
    <div class="eyebrow">YOUR PERSONAL LIBRARY</div>
    <h1>Everything<br>in its place.</h1>
    <p>Choose what you want to listen to or watch.</p>
  </div>

  <div class="media-options">

    <button class="media-card" onclick="openWorkspace('music')">
      <div class="card-symbol">
        <svg viewBox="0 0 24 24">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>
      </div>
      <h2>Music</h2>
      <p>Your songs, albums and playlists</p>
    </button>

    <button class="media-card" onclick="openWorkspace('video')">
      <div class="card-symbol">
        <svg viewBox="0 0 24 24">
          <rect x="3" y="5" width="18" height="14" rx="3"/>
          <path d="m10 9 5 3-5 3z"/>
        </svg>
      </div>
      <h2>Video</h2>
      <p>Your films, clips and recordings</p>
    </button>

  </div>

  <div class="home-footer">A quieter place for your media.</div>
</section>

<!-- MUSIC WORKSPACE -->
<section class="workspace" id="musicWorkspace">

  <header class="topbar">
    <button class="icon-button" onclick="goHome()" aria-label="Back home">
      <svg viewBox="0 0 24 24">
        <path d="m15 18-6-6 6-6"/>
      </svg>
    </button>

    <div class="topbar-title">Music</div>

    <div class="topbar-actions">
      <button class="icon-button" onclick="openLibrary('music')" aria-label="Music library">
        <svg viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
      <button class="icon-button" onclick="openSearch('music')" aria-label="Search music">
        <svg viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7"/>
          <path d="m20 20-4-4"/>
        </svg>
      </button>
    </div>
  </header>

  <div class="workspace-body">
    <div class="player-layout">

      <div class="player-stage" style="background:linear-gradient(145deg,#484848,#171717)">
        <div class="music-artwork" id="musicArtwork">
          <div class="artwork-placeholder">
            <svg viewBox="0 0 24 24">
              <path d="M9 18V5l12-2v13"/>
              <circle cx="6" cy="18" r="3"/>
              <circle cx="18" cy="16" r="3"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="track-info">
        <div style="min-width:0">

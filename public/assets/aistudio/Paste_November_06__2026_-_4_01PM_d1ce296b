<script>
/* --------------------------------------------------
   FORGE MEDIA V2.2
-------------------------------------------------- */

const $ = id => document.getElementById(id);

const DB_NAME = 'ForgeMediaDB';
const DB_VERSION = 1;

let db = null;
let currentWorkspace = 'music';
let libraryView = 'list';
let shuffle = false;
let repeat = false;
let videoSpeed = 1;
let currentObjectURL = null;
let audioContext = null;
let audioSource = null;
let equalizerFilters = [];
let equalizerEnabled = false;
let currentLyrics = [];
let currentLyricsRaw = '';
let searchMode = 'music';

const audio = $('audio');
const video = $('video');

const state = {
  music: {
    files: [],
    current: null,
    index: -1
  },
  video: {
    files: [],
    current: null,
    index: -1
  }
};

function activeState() {
  return state[currentWorkspace];
}

/* DATABASE */

function openDatabase() {
  return new Promise((resolve,reject) => {
    const request = indexedDB.open(DB_NAME,DB_VERSION);

    request.onupgradeneeded = e => {
      const database = e.target.result;
      if (!database.objectStoreNames.contains('media')) {
        database.createObjectStore('media',{keyPath:'id'});
      }
      if (!database.objectStoreNames.contains('lyrics')) {
        database.createObjectStore('lyrics',{keyPath:'id'});
      }
    };

    request.onsuccess = e => resolve(e.target.result);
    request.onerror = () => reject(request.error);
  });
}

function dbAction(store,mode,action) {
  return new Promise((resolve,reject) => {
    const tx = db.transaction(store,mode);
    const objectStore = tx.objectStore(store);
    const request = action(objectStore);
    request.onsuccess = () => resolve(request.result);
    request.onerror = () => reject(request.error);
  });
}

async function loadStoredMedia() {
  const records = await dbAction('media','readonly',s => s.getAll());

  state.music.files = records.filter(x => x.type === 'music');
  state.video.files = records.filter(x => x.type === 'video');

  renderLibrary();
}

async function persistFile(item) {
  await dbAction('media','readwrite',s => s.put(item));
}

function makeId() {
  return Date.now() + '-' + Math.random().toString(36).slice(2);
}

/* APPEARANCE */

function setAppearance(theme) {
  document.documentElement.dataset.theme = theme;
  localStorage.setItem('forge-media-theme',theme);

  $('appearanceIcon').innerHTML = theme === 'dark'
    ? '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2"/>'
    : '<path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z"/>';

  document.querySelector('meta[name="theme-color"]').content =
    theme === 'dark' ? '#111111' : '#f2f2f0';
}

$('appearanceToggle').onclick = () => {
  setAppearance(
    document.documentElement.dataset.theme === 'dark'
      ? 'light'
      : 'dark'
  );
};

setAppearance(localStorage.getItem('forge-media-theme') || 'dark');

/* NAVIGATION */

function openWorkspace(type) {
  currentWorkspace = type;
  $('home').classList.add('hidden');
  $('musicWorkspace').classList.toggle('active',type === 'music');
  $('videoWorkspace').classList.toggle('active',type === 'video');
}

function goHome() {
  closeLibrary();
  closeAllModals();

  $('musicWorkspace').classList.remove('active');
  $('videoWorkspace').classList.remove('active');
  $('home').classList.remove('hidden');
}

/* LIBRARY */

function openLibrary(type) {
  currentWorkspace = type;
  $('libraryTitle').textContent =
    type === 'music' ? 'Music library' : 'Video library';

  $('librarySearch').value = '';
  libraryView = 'list';

  document.querySelectorAll('.library-tabs button').forEach((b,i) => {
    b.classList.toggle('active',i === 0);
  });

  renderLibrary();

  $('libraryPanel').classList.add('open');
  $('panelOverlay').classList.add('visible');
}

function closeLibrary() {
  $('libraryPanel').classList.remove('open');
  $('panelOverlay').classList.remove('visible');
}

function setLibraryView(view,button) {
  libraryView = view;

  document.querySelectorAll('.library-tabs button').forEach(b => {
    b.classList.remove('active');
  });

  button.classList.add('active');
  renderLibrary();
}

function openSearch(type) {
  openLibrary(type);
  $('librarySearch').focus();
}

$('librarySearch').addEventListener('input',renderLibrary);

function renderLibrary() {
  if (!db) return;

  const type = currentWorkspace;
  const files = state[type].files;
  const query = $('librarySearch').value.toLowerCase();

  const filtered = files.filter(f =>
    f.name.toLowerCase().includes(query)
  );

  const content = $('libraryContent');

  if (!filtered.length) {
    content.innerHTML = `
      <div class="empty-state">
        <svg viewBox="0 0 24 24">
          <path d="M4 5h16v14H4zM9 9l6 3-6 3z"/>
        </svg>
        <strong>${query ? 'No matching media' : 'Your library is empty'}</strong>
        <p>${query ? 'Try another search.' : 'Add files to start building your collection.'}</p>
      </div>`;
    return;
  }

  if (libraryView === 'hero') {
    content.innerHTML = `
      <div class="hero-grid">
        ${filtered.map(f => `
          <button class="hero-item" onclick="playFile('${f.id}')">
            <div class="hero-thumb">
              ${type === 'video'
                ? '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/></svg>'
                : '<svg viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>'}
            </div>
            <div class="hero-info">
              <strong>${escapeHTML(f.name)}</strong>
              <small>${formatSize(f.size)}</small>
            </div>
          </button>
        `).join('')}
      </div>`;
  } else {
    content.innerHTML = `
      <div class="media-list">
        ${filtered.map(f => `
          <button class="media-item" onclick="playFile('${f.id}')">
            <div class="media-thumb">
              ${type === 'video'
                ? '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9 5 3-5 3z"/></svg>'
                : '<svg viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>'}
            </div>
            <div class="media-item-info">
              <strong>${escapeHTML(f.name)}</strong>
              <small>${formatSize(f.size)}</small>
            </div>
            <span class="more">›</span>
          </button>
        `).join('')}
      </div>`;
  }
}

/* FILE IMPORT */

$('filePicker').addEventListener('change',async e => {
  const files = [...e.target.files];

  for (const file of files) {
    const isAudio = file.type.startsWith('audio/');
    const isVideo = file.type.startsWith('video/');

    if (!isAudio && !isVideo) continue;

    const item = {
      id:makeId(),
      name:file.name,
      size:file.size,
      mime:file.type,
      type:isAudio ? 'music' : 'video',
      blob:file
    };

    await persistFile(item);
    state[item.type].files.push(item);
  }

  e.target.value = '';
  renderLibrary();
});

/* MEDIA PLAYBACK */

function revokeCurrentURL() {
  if (currentObjectURL) {
    URL.revokeObjectURL(currentObjectURL);
    currentObjectURL = null;
  }
}

async function playFile(id) {
  const type = currentWorkspace;
  const s = state[type];

  const index = s.files.findIndex(f => f.id === id);
  if (index < 0) return;

  s.index = index;
  s.current = s.files[index];

  const item = s.current;

  revokeCurrentURL();
  currentObjectURL = URL.createObjectURL(item.blob);

  closeLibrary();

  if (type === 'music') {
    audio.src = currentObjectURL;

    $('musicTitle').textContent = item.name.replace(/\.[^.]+$/,'');
    $('musicArtist').textContent = 'Local audio file';
    $('musicArtwork').classList.remove('hidden');

    try {
      await audio.play();
      updatePlayIcon('music',true);
    } catch(e) {
      updatePlayIcon('music',false);
    }

  } else {
    video.pause();
    video.src = currentObjectURL;
    video.playsInline = true;
    video.controls = false;

    $('videoPlaceholder').style.display = 'none';
    video.classList.add('visible');
    $('videoOverlay').classList.add('visible');

    $('videoTitle').textContent = item.name.replace(/\.[^.]+$/,'');
    $('videoDescription').textContent = 'Local video file';

    try {
      await video.play();
      updatePlayIcon('video',true);
    } catch(e) {
      updatePlayIcon('video',false);
    }
  }
}

function togglePlayback(type) {
  if (type === 'music') {
    if (!audio.src) return;
    if (audio.paused) audio.play().catch(()=>{});
    else audio.pause();
  } else {
    if (!video.src) return;
    if (video.paused) video.play().catch(()=>{});
    else video.pause();
  }
}

function toggleVideoPlay() {
  togglePlayback('video');
}

function updatePlayIcon(type,playing) {
  const target = type === 'music' ? $('musicPlayIcon') : $('videoPlayIcon');

  target.innerHTML = playing
    ? '<path d="M7 5h4v14H7zm7 0h4v14h-4z"/>'
    : '<path d="M8 5v14l11-7z"/>';
}

audio.addEventListener('play',()=>updatePlayIcon('music',true));
audio.addEventListener('pause',()=>updatePlayIcon('music',false));
video.addEventListener('play',()=>updatePlayIcon('video',true));
video.addEventListener('pause',()=>updatePlayIcon('video',false));

/* SEEKING */

function formatTime(seconds) {
  if (!Number.isFinite(seconds)) return '0:00';
  const m = Math.floor(seconds/60);
  const s = Math.floor(seconds%60);
  return m + ':' + String(s).padStart(2,'0');
}

audio.addEventListener('timeupdate',() => {
  const duration = audio.duration || 0;

  $('musicSeek').value = duration
    ? audio.currentTime/duration*1000
    : 0;

  $('musicCurrent').textContent = formatTime(audio.currentTime);
  $('musicDuration').textContent = formatTime(duration);

  updateLyrics();
});

$('musicSeek').addEventListener('input',e => {
  if (audio.duration) {
    audio.currentTime = e.target.value/1000*audio.duration;
  }
});

video.addEventListener('timeupdate',() => {
  const duration = video.duration || 0;

  $('videoSeek').value = duration
    ? video.currentTime/duration*1000
    : 0;

  $('videoCurrent').textContent = formatTime(video.currentTime);
  $('videoDuration').textContent = formatTime(duration);
});

$('videoSeek').addEventListener('input',e => {
  if (video.duration) {
    video.currentTime = e.target.value/1000*video.duration;
  }
});

function skipVideo(seconds) {
  video.currentTime = Math.max(
    0,
    Math.min(video.duration || 0,video.currentTime+seconds)
  );
}

function changeVideoSpeed() {
  const speeds = [1,1.25,1.5,2,.75];
  const index = speeds.indexOf(videoSpeed);
  videoSpeed = speeds[(index+1)%speeds.length];
  video.playbackRate = videoSpeed;
  document.querySelector('.video-controls button:last-child').textContent = videoSpeed+'×';
}

function toggleVideoMute() {
  video.muted = !video.muted;
}

/* TRACK NAVIGATION */

function nextTrack() {
  const s = state.music;
  if (!s.files.length) return;

  let next = shuffle
    ? Math.floor(Math.random()*s.files.length)
    : (s.index+1)%s.files.length;

  playFile(s.files[next].id);
}

function previousTrack() {
  const s = state.music;
  if (!s.files.length) return;

  const next = s.index <= 0
    ? s.files.length-1
    : s.index-1;

  playFile(s.files[next].id);
}

function toggleShuffle() {
  shuffle = !shuffle;
  $('shuffleButton').style.opacity = shuffle ? '1' : '.45';
}

function toggleRepeat() {
  repeat = !repeat;
  audio.loop = repeat;
  $('repeatButton').style.opacity = repeat ? '1' : '.45';
}

audio.addEventListener('ended',() => {
  if (!repeat) nextTrack();
});

/* EQUALIZER */

async function initEqualizer() {
  if (audioContext) return;

  const AudioContextClass =
    window.AudioContext || window.webkitAudioContext;

  if (!AudioContextClass) {
    alert('Audio equalizer is not supported by this browser.');
    return;
  }

  try {
    audioContext = new AudioContextClass();

    audioSource = audioContext.createMediaElementSource(audio);

    const frequencies = [60,230,910,3600,14000];

    equalizerFilters = frequencies.map(freq => {
      const filter = audioContext.createBiquadFilter();

      filter.type =
        freq === 60 ? 'lowshelf' :
        freq === 14000 ? 'highshelf' :
        'peaking';

      filter.frequency.value = freq;
      filter.Q.value = 1;

      return filter;
    });

    audioSource.connect(equalizerFilters[0]);

    equalizerFilters.forEach((filter,i) => {
      if (equalizerFilters[i+1]) {
        filter.connect(equalizerFilters[i+1]);
      } else {
        filter.connect(audioContext.destination);
      }
    });

    equalizerEnabled = true;
    $('eqStatus').textContent = 'On';

  } catch(e) {
    console.error('Equalizer initialization failed',e);
    alert('Could not initialize the equalizer.');
  }
}

document.querySelectorAll('[data-frequency]').forEach(input => {
  input.addEventListener('input',async e => {
    await initEqualizer();

    const index = [...document.querySelectorAll('[data-frequency]')].indexOf(e.target);

    if (equalizerFilters[index]) {
      equalizerFilters[index].gain.value = Number(e.target.value);
    }
  });
});

async function setPreset(name) {
  await initEqualizer();

  const presets = {
    Flat:[0,0,0,0,0],
    Bass:[8,5,0,-1,-2],
    Treble:[-2,-1,0,5,8],
    Vocal:[-2,2,5,3,-1],
    Rock:[5,3,-1,3,6]
  };

  const values = presets[name];

  document.querySelectorAll('[data-frequency]').forEach((input,i) => {
    input.value = values[i];
    if (equalizerFilters[i]) {
      equalizerFilters[i].gain.value = values[i];
    }
  });
}

function resetEqualizer() {
  document.querySelectorAll('[data-frequency]').forEach(input => {
    input.value = 0;
  });

  equalizerFilters.forEach(filter => {
    filter.gain.value = 0;
  });
}

/* LYRICS */

function openLyrics() {
  const current = state.music.current;

  $('lyricsInput').value = current
    ? localStorage.getItem('lyrics-'+current.id) || ''
    : '';

  parseLyrics($('lyricsInput').value);
  openModal('lyricsModal');
}

function parseLyrics(raw) {
  currentLyricsRaw = raw;
  currentLyrics = [];

  const lines = raw.split(/\r?\n/);

  lines.forEach(line => {
    const matches = [...line.matchAll(/\[(\d{2}):(\d{2})(?:\.(\d{1,3}))?\]/g)];

    matches.forEach(match => {
      const time = Number(match[1])*60 +
        Number(match[2]) +
        Number('0.'+(match[3] || '0'));

      currentLyrics.push({
        time,
        text:line.replace(/\[\d{2}:\d{2}(?:\.\d{1,3})?\]/g,'').trim()
      });
    });
  });

  currentLyrics.sort((a,b)=>a.time-b.time);
  renderLyrics();
}

function renderLyrics() {
  const box = $('lyricsDisplay');

  if (!currentLyrics.length) {
    box.textContent = currentLyricsRaw || 'No lyrics available.';
    return;
  }

  box.innerHTML = currentLyrics.map((line,i) => `
    <div id="lyric-${i}">${escapeHTML(line.text)}</div>
  `).join('');
}

function updateLyrics() {
  if (!currentLyrics.length) return;

  let active = -1;

  currentLyrics.forEach((line,i) => {
    if (audio.currentTime >= line.time) active = i;
  });

  document.querySelectorAll('.lyrics-box div').forEach((el,i) => {
    el.classList.toggle('current-line',i === active);
  });

  const activeElement = $('lyric-'+active);

  if (activeElement && $('lyricsModal').classList.contains('open')) {
    activeElement.scrollIntoView({
      block:'center',
      behavior:'smooth'
    });
  }
}

function saveLyrics() {
  const current = state.music.current;

  if (!current) {
    alert('Select a song first.');
    return;
  }

  const raw = $('lyricsInput').value;

  localStorage.setItem('lyrics-'+current.id,raw);
  parseLyrics(raw);
  closeModal('lyricsModal');
}

$('lrcPicker').addEventListener('change',async e => {
  const file = e.target.files[0];
  if (!file) return;

  $('lyricsInput').value = await file.text();
  parseLyrics($('lyricsInput').value);
  e.target.value = '';
});

/* MODALS */

function openModal(id) {
  $(id).classList.add('open');
}

function closeModal(id) {
  $(id).classList.remove('open');
}

function closeAllModals() {
  document.querySelectorAll('.modal').forEach(m => {
    m.classList.remove('open');
  });
}

/* UTILITIES */

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g,char => ({
    '&':'&amp;',
    '<':'&lt;',
    '>':'&gt;',
    '"':'&quot;',
    "'":'&#39;'
  })[char]);
}

function formatSize(bytes) {
  if (!bytes) return 'Unknown size';
  const mb = bytes/1024/1024;
  return mb >= 1024
    ? (mb/1024).toFixed(2)+' GB'
    : mb.toFixed(1)+' MB';
}

/* INITIALIZATION */

(async function init() {
  try {
    db = await openDatabase();
    await loadStoredMedia();
  } catch(error) {
    console.error('Database initialization failed',error);
    alert('Local media storage could not be initialized.');
  }
})();

/* RELEASE TEMPORARY MEDIA URLS */

window.addEventListener('pagehide',() => {
  revokeCurrentURL();
});
</script>


<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#0b0b0a" />
<meta name="description" content="Sonara — private offline media vault for audio, video, images and documents. Device only." />
<title>Sonara — Offline Media Hub</title>
<style>
:root {
  --bg: #0b0b0a;
  --surface: #171715;
  --raised: #22211e;
  --soft: #2b2925;
  --text: #f5f2ea;
  --muted: #a09b90;
  --dim: #6f6b63;
  --accent: #d97757;
  --accent-soft: #3a2118;
  --green: #76c893;
  --danger: #e98a80;
  --line: rgba(245,242,234,.08);
  --white-line: rgba(245,242,234,.14);
  --ease: cubic-bezier(.23,1,.32,1);
  --safe-b: env(safe-area-inset-bottom, 0px);
  --safe-t: env(safe-area-inset-top, 0px);
  /* Spacious scale (8dp multiples) */
  --s1: 8px;
  --s2: 16px;
  --s3: 24px;
  --s4: 32px;
  --s5: 40px;
  --s6: 48px;
  --s7: 56px;
  --s8: 64px;
  --s9: 80px;
}
* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", system-ui, sans-serif; }
body { padding: 0 0 calc(128px + var(--safe-b)); -webkit-font-smoothing: antialiased; }
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; border: 0; background: none; }
button:active { transform: scale(.98); }
button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

.app { max-width: 680px; margin: 0 auto; padding: var(--s5) var(--s3) var(--s6); }

.topline, .section-head, .mini, .row, .setting, .feature-top, .tabbar, .sheet-head, .time { display: flex; align-items: center; }
.topline, .section-head, .mini, .setting, .sheet-head, .time { justify-content: space-between; }

.brand { font-size: 32px; line-height: 1; font-weight: 650; letter-spacing: -1.4px; }
.brand i { color: var(--accent); font-style: normal; }
.eyebrow, .label { color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; }
.eyebrow { margin-top: 10px; }

.pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 8px 12px; background: var(--soft); color: var(--muted); font-size: 10px; font-weight: 800; letter-spacing: .6px; }
.pill.green { background: rgba(118,200,147,.14); color: #9be0b0; }
.pill.accent { background: var(--accent-soft); color: #e99c82; }

/* Hero — large type + open air */
.hero { padding: var(--s8) 0 var(--s6); }
.hero .eyebrow { color: var(--accent); margin-bottom: 4px; }
h1 { font-size: clamp(44px, 11vw, 76px); line-height: .96; letter-spacing: -3.2px; font-weight: 500; margin: 16px 0 24px; max-width: 560px; }
.body { color: var(--muted); font-size: 17px; line-height: 1.55; max-width: 480px; }

.primary { background: var(--accent); color: #1a0f0a; padding: 18px 22px; border-radius: 14px; font-size: 13px; font-weight: 800; letter-spacing: .6px; margin-top: 32px; }
.secondary { border: 1px solid var(--accent); color: var(--accent); padding: 16px 20px; border-radius: 14px; font-size: 13px; font-weight: 800; letter-spacing: .6px; margin-top: 24px; display: inline-block; }

/* Stats — quiet, spaced */
.stats { display: flex; gap: var(--s5); padding: var(--s5) 0; margin: var(--s4) 0 var(--s7); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.stat strong { display: block; font-size: 28px; font-weight: 520; letter-spacing: -0.8px; }
.stat span { display: block; color: var(--dim); font-size: 11px; letter-spacing: 1.2px; margin-top: 6px; text-transform: uppercase; }

/* Section heads — more air */
.section-head { align-items: end; margin: var(--s7) 0 var(--s3); }
.section-head h2 { font-size: 26px; font-weight: 550; letter-spacing: -.6px; margin: 8px 0 0; }
.link { color: var(--accent); font-size: 13px; font-weight: 700; letter-spacing: .3px; }

/* Feature / hero card — generous padding */
.feature { background: var(--surface); border: 1px solid var(--line); border-radius: 28px; padding: var(--s4); }
.feature-top { gap: var(--s3); flex-direction: column; align-items: flex-start; }
.feature-copy { flex: 1; min-width: 0; width: 100%; }
.feature h3 { font-size: 28px; font-weight: 560; margin: 14px 0 6px; letter-spacing: -.4px; }
.meta { color: var(--muted); font-size: 15px; }
.feature-open { display: block; width: 100%; text-align: left; color: var(--accent); border-top: 1px solid var(--line); padding-top: 20px; margin-top: 24px; font-size: 13px; font-weight: 800; letter-spacing: .5px; }

.art { display: grid; place-items: center; border-radius: 18px; flex: none; font-size: 32px; font-weight: 400; background: #332521; color: #ddb19a; }
.art.small { width: 64px; height: 64px; font-size: 26px; border-radius: 16px; }
.art.large { width: min(78vw, 300px); height: min(78vw, 300px); margin: 0 auto 8px; font-size: 96px; border-radius: 24px; }

/* List rows — taller, calmer */
.row { gap: 16px; padding: 18px 8px; border-bottom: 1px solid var(--line); min-height: 88px; }
.row.active { background: rgba(217,119,87,.07); border-radius: 16px; }
.copy { min-width: 0; flex: 1; }
.title { font-size: 17px; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: -.2px; }
.track-meta { color: var(--muted); font-size: 13px; margin-top: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row-right { display: flex; align-items: center; gap: 10px; }
.equal { color: var(--accent); font-size: 13px; letter-spacing: 2px; }

.search { width: 100%; height: 56px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); color: var(--text); padding: 0 20px; outline: none; font-size: 16px; }
.search:focus { border-color: var(--accent); }

.note, .empty { background: var(--surface); border-radius: 24px; border: 1px solid var(--line); padding: var(--s4); }
.note { background: var(--accent-soft); border-color: transparent; margin-top: var(--s7); }
.note b { color: var(--accent); font-size: 11px; letter-spacing: 1.5px; }
.note p { font-size: 16px; line-height: 1.5; margin: 12px 0 0; }
.empty h3 { margin: 0; font-size: 22px; font-weight: 560; }
.empty p { color: var(--muted); font-size: 15px; line-height: 1.5; margin: 12px 0 0; }

.playlist { display: flex; gap: 16px; align-items: center; padding: 14px 0; }
.playlist-icon { display: grid; place-items: center; width: 56px; height: 56px; background: var(--soft); border-radius: 16px; color: var(--accent); font-size: 24px; }

.settings-hero { background: var(--surface); border: 1px solid var(--line); border-radius: 28px; padding: var(--s5); margin-top: var(--s4); }
.settings-hero h2 { font-size: 32px; font-weight: 520; letter-spacing: -1.2px; margin: 14px 0 10px; }
.setting { padding: 22px 0; border-bottom: 1px solid var(--line); }
.setting-title { font-size: 17px; font-weight: 650; }
.setting-desc { color: var(--muted); font-size: 13px; margin-top: 6px; }
.switch { width: 52px; height: 32px; border-radius: 20px; background: var(--soft); padding: 4px; transition: background .18s var(--ease); }
.switch span { display: block; width: 24px; height: 24px; background: var(--muted); border-radius: 50%; transition: transform .18s var(--ease), background .18s var(--ease); }
.switch.on { background: var(--accent); }
.switch.on span { transform: translateX(20px); background: #fff; }

.danger { width: 100%; border: 1px solid rgba(220,80,70,.45); color: var(--danger); border-radius: 14px; padding: 18px; margin-top: var(--s7); font-size: 13px; font-weight: 800; letter-spacing: .5px; }
.version { text-align: center; color: var(--dim); font-size: 11px; letter-spacing: 1.2px; margin: var(--s7) 0; }

/* Bottom player — more air */
.bottom { position: fixed; z-index: 5; left: 0; right: 0; bottom: 0; background: rgba(11,11,10,.97); border-top: 1px solid var(--line); padding: 12px max(20px, calc((100vw - 680px)/2 + 20px)) calc(14px + var(--safe-b)); backdrop-filter: blur(16px); }
.mini { background: var(--raised); border: 1px solid var(--white-line); border-radius: 18px; padding: 12px 14px; gap: 14px; }
.mini-main { display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1; text-align: left; }
.mini-copy { min-width: 0; }
.mini .title { font-size: 15px; }
.mini .track-meta { font-size: 12px; }
.offline { color: var(--green); font-weight: 800; }
.controls { display: flex; align-items: center; gap: 14px; }
.control { font-size: 28px; line-height: 1; min-width: 40px; min-height: 40px; }
.play { width: 44px; height: 44px; border-radius: 50%; background: var(--accent); color: #1a0f0a; font-size: 16px; font-weight: 900; display: grid; place-items: center; }
.tabbar { justify-content: space-around; margin-top: 12px; }
.tab { color: var(--dim); font-size: 11px; font-weight: 800; letter-spacing: .7px; padding: 12px 10px; }
.tab.active { color: var(--accent); }

/* Sheets */
.modal { position: fixed; inset: 0; z-index: 10; background: rgba(0,0,0,.72); display: flex; align-items: flex-end; }
.sheet { background: var(--bg); border-radius: 32px 32px 0 0; padding: 18px 24px calc(36px + var(--safe-b)); width: 100%; max-height: 94vh; overflow: auto; animation: up .26s var(--ease); }
@keyframes up { from { transform: translateY(24px); opacity: .5; } to { transform: none; opacity: 1; } }
.handle { width: 48px; height: 5px; border-radius: 4px; background: var(--soft); margin: 0 auto 24px; }
.close { font-size: 34px; color: var(--muted); font-weight: 300; line-height: 1; min-width: 44px; min-height: 44px; }
.player h2 { font-size: 32px; margin: 24px 0 8px; letter-spacing: -.6px; font-weight: 560; }
.player .meta { font-size: 16px; }
.progress { height: 6px; background: var(--soft); border-radius: 4px; margin-top: 28px; overflow: hidden; }
.progress i { display: block; height: 100%; background: var(--accent); width: 0; transition: width .1s linear; }
.time { color: var(--dim); font-size: 12px; margin-top: 10px; }
.transport { display: flex; align-items: center; justify-content: space-between; margin: 28px 0; }
.transport button { font-size: 28px; min-width: 48px; min-height: 48px; }
.transport .big { width: 72px; height: 72px; border-radius: 50%; background: var(--accent); color: #1a0f0a; font-size: 24px; font-weight: 900; display: grid; place-items: center; }
.chips { display: flex; gap: 10px; flex-wrap: wrap; margin: 20px 0; }
.chip { border: 1px solid var(--line); border-radius: 999px; padding: 12px 16px; color: var(--muted); font-size: 12px; font-weight: 750; letter-spacing: .5px; }
.chip.active { background: var(--accent-soft); border-color: var(--accent); color: var(--text); }
.lyrics { min-height: 50vh; }
.lyrics-line { font-size: 28px; line-height: 1.4; color: var(--muted); margin: 0 0 22px; }
.lyrics-line.active { color: var(--text); font-size: 34px; font-weight: 620; }

.hidden { display: none !important; }
.video-wrap { background: #000; border-radius: 24px; overflow: hidden; margin-top: var(--s4); border: 1px solid var(--line); }
.video-wrap video { display: block; width: 100%; max-height: 56vh; background: #000; }

.media-filters { display: flex; gap: 10px; flex-wrap: wrap; margin: 24px 0 20px; }
.filter-chip { border: 1px solid var(--line); border-radius: 999px; padding: 12px 16px; color: var(--muted); font-size: 12px; font-weight: 750; letter-spacing: .4px; }
.filter-chip.active { background: var(--accent-soft); border-color: var(--accent); color: var(--text); }
.media-type { font-size: 11px; font-weight: 800; letter-spacing: .7px; color: var(--accent); }
.media-actions { display: flex; align-items: center; gap: 12px; }

.toast { position: fixed; z-index: 30; left: 50%; bottom: calc(140px + var(--safe-b)); transform: translateX(-50%); background: var(--raised); border: 1px solid var(--white-line); border-radius: 999px; padding: 14px 20px; color: var(--text); font-size: 14px; box-shadow: 0 16px 40px #0009; max-width: 90vw; text-align: center; }
.toast.error { border-color: var(--danger); color: #ffd1cb; }

.viewer-media { max-width: 100%; max-height: 56vh; display: block; margin: 24px auto; border-radius: 20px; background: #000; }
.viewer-doc { width: 100%; height: 56vh; border: 1px solid var(--line); border-radius: 20px; background: #fff; margin-top: 24px; }
.metadata-line { color: var(--muted); font-size: 14px; line-height: 1.5; margin-top: 14px; }

.spotify-card { background: linear-gradient(135deg, #183d2b, #12231b); border: 1px solid rgba(118,200,147,.28); border-radius: 28px; padding: var(--s4); margin-top: var(--s4); }
.spotify-mark { color: #9be0b0; font-size: 11px; font-weight: 800; letter-spacing: 1.3px; }
.form-row { display: grid; gap: 10px; margin-top: 20px; }
.form-row label { color: var(--muted); font-size: 11px; font-weight: 750; letter-spacing: .8px; }
.form-row input { width: 100%; height: 52px; border: 1px solid var(--white-line); border-radius: 14px; background: rgba(0,0,0,.25); color: var(--text); padding: 0 16px; outline: none; font-size: 16px; }
.form-row input:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(118,200,147,.15); }
.spotify-status { color: #b8ddc3; font-size: 14px; line-height: 1.5; margin-top: 16px; }
.spotify-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.spotify-actions .primary { margin-top: 18px; background: #1ed760; color: #07130a; }
.spotify-actions .secondary { margin-top: 18px; border-color: #9be0b0; color: #9be0b0; }
.spotify-list { margin-top: 20px; }

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }

@media (min-width: 680px) {
  .app { padding-top: var(--s8); padding-left: var(--s5); padding-right: var(--s5); }
  .hero { padding-top: var(--s9); }
  .hero h1 { font-size: 76px; }
  .feature-top { flex-direction: row; align-items: center; }
  .art.large { margin: 0; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

/* —— Real library + clean empty —— */
.lib-toolbar { margin-top: var(--s4); }
.lib-controls { margin-top: var(--s3); }
.lib-meta-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 16px; }
.lib-select {
  height: 44px; border: 1px solid var(--line); border-radius: 12px;
  background: var(--surface); color: var(--text); padding: 0 14px;
  font-size: 14px; outline: none; min-width: 120px;
}
.lib-select:focus { border-color: var(--accent); }
.view-toggle { display: flex; gap: 4px; margin-left: auto; }
.view-btn {
  width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line);
  background: var(--surface); color: var(--muted); font-size: 16px;
  display: grid; place-items: center;
}
.view-btn.active { background: var(--accent-soft); border-color: var(--accent); color: var(--text); }
.group-label {
  font-size: 12px; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase;
  color: var(--dim); margin: 28px 0 12px; padding-left: 4px;
}
.grid-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 16px;
  margin-bottom: 12px;
}
.grid-card {
  background: var(--surface); border: 1px solid var(--line); border-radius: 20px;
  padding: 14px; text-align: left; display: flex; flex-direction: column; gap: 10px;
  min-height: 180px;
}
.grid-card.active { border-color: var(--accent); background: rgba(217,119,87,.08); }
.grid-art {
  width: 100%; aspect-ratio: 1; border-radius: 14px;
  display: grid; place-items: center; font-size: 36px; color: rgba(245,242,234,.7);
}
.grid-title {
  font-size: 15px; font-weight: 650; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.grid-meta { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Centered, calm empty state (Google Artifacts style) */
.lib-empty {
  min-height: 52vh;
  display: grid;
  place-items: center;
  padding: 48px 24px;
  margin: 24px 0;
}
.lib-empty-inner {
  text-align: center;
  max-width: 360px;
}
.lib-empty-inner h2 {
  font-size: clamp(28px, 7vw, 40px);
  font-weight: 520;
  letter-spacing: -1.2px;
  line-height: 1.15;
  margin: 0 0 16px;
  color: var(--text);
}
.lib-empty-inner p {
  color: var(--muted);
  font-size: 16px;
  line-height: 1.5;
  margin: 0 0 28px;
}
.lib-empty-inner .primary {
  margin-top: 0;
  padding: 16px 28px;
  font-size: 14px;
}

.media-list { margin-bottom: 8px; }


/* —— Artifacts-style Home —— */
.home-top { padding: 12px 0 8px; }
.home-title-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.home-title {
  font-size: clamp(36px, 9vw, 48px);
  font-weight: 520;
  letter-spacing: -1.8px;
  margin: 0;
  line-height: 1.05;
}
.home-actions { display: flex; gap: 8px; }
.icon-btn {
  width: 44px; height: 44px; border-radius: 12px;
  background: transparent; color: var(--muted);
  font-size: 20px; display: grid; place-items: center;
}
.icon-btn:active { background: var(--soft); }
.home-sub {
  color: var(--dim);
  font-size: 14px;
  margin-top: 10px;
  letter-spacing: .2px;
}

.make-section { margin-top: 40px; }
.make-label {
  color: var(--dim);
  font-size: 14px;
  margin-bottom: 16px;
  letter-spacing: .2px;
}
.make-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.make-card {
  position: relative;
  border-radius: 20px;
  padding: 22px 16px 18px;
  text-align: left;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 0;
  overflow: hidden;
}
.make-audio { background: linear-gradient(145deg, #2a221c, #1c1814); }
.make-video { background: linear-gradient(145deg, #1f2428, #15181b); }
.make-files { background: linear-gradient(145deg, #22201c, #181612); }
.make-icon {
  font-size: 28px;
  color: rgba(245,242,234,.85);
  margin-bottom: 18px;
}
.make-name {
  font-size: 15px;
  font-weight: 650;
  letter-spacing: -.2px;
}
.make-badge {
  position: absolute;
  top: 12px; right: 12px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .4px;
  padding: 4px 8px;
  border-radius: 999px;
  background: rgba(217,119,87,.22);
  color: #e9b39a;
}

.continue-section { margin-top: 44px; }
.continue-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 16px;
  text-align: left;
  margin-top: 8px;
}
.continue-art {
  width: 72px; height: 72px; border-radius: 16px;
  display: grid; place-items: center;
  font-size: 28px; font-weight: 500;
  color: rgba(245,242,234,.8);
  flex: none;
}
.continue-body { flex: 1; min-width: 0; }
.continue-title {
  font-size: 18px; font-weight: 650; letter-spacing: -.3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.continue-meta {
  color: var(--muted); font-size: 13px; margin-top: 4px;
}
.continue-play {
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--accent); color: #1a0f0a;
  display: grid; place-items: center;
  font-size: 16px; font-weight: 900; flex: none;
}
.continue-list { margin-top: 8px; }
.continue-row {
  width: 100%;
  display: flex; align-items: center; gap: 14px;
  padding: 14px 8px;
  text-align: left;
  border-radius: 14px;
}
.continue-row:active { background: rgba(245,242,234,.04); }
.continue-row-art {
  width: 48px; height: 48px; border-radius: 12px;
  background: var(--soft);
  display: grid; place-items: center;
  font-size: 18px; color: var(--muted); flex: none;
}

.home-stats {
  display: flex; gap: 32px;
  margin-top: 48px;
  padding-top: 28px;
  border-top: 1px solid var(--line);
}
.home-stat strong {
  display: block; font-size: 22px; font-weight: 550; letter-spacing: -.4px;
}
.home-stat span {
  display: block; color: var(--dim); font-size: 12px;
  letter-spacing: .8px; text-transform: uppercase; margin-top: 4px;
}

.home-foot {
  margin-top: 40px;
  padding-bottom: 12px;
}
.home-foot p {
  color: var(--dim);
  font-size: 14px;
  line-height: 1.5;
  margin: 0;
  max-width: 320px;
}

@media (min-width: 680px) {
  .make-grid { grid-template-columns: repeat(3, 160px); }
  .continue-art { width: 88px; height: 88px; font-size: 34px; }
}


.video-stage {
  margin-top: 24px;
  background: #000;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid var(--line);
}
.video-stage video {
  display: block;
  width: 100%;
  max-height: 56vh;
  background: #000;
}
.video-caption-bar {
  padding: 14px 16px;
  background: var(--surface);
}
.sub-paste {
  width: 100%;
  min-height: 120px;
  border: 1px solid var(--white-line);
  border-radius: 14px;
  background: rgba(0,0,0,.25);
  color: var(--text);
  padding: 12px 14px;
  font-size: 13px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  outline: none;
  resize: vertical;
}
.sub-paste:focus { border-color: var(--accent); }
.tabbar { flex-wrap: wrap; gap: 2px; }
.tab { font-size: 9px; padding: 8px 6px; letter-spacing: .4px; }


.eq-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 16px 0 20px;
}
.eq-bands {
  display: flex;
  gap: 6px;
  justify-content: space-between;
  align-items: flex-end;
  padding: 16px 8px 8px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 20px;
  overflow-x: auto;
}
.eq-band {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  min-width: 40px;
  flex: 1;
}
.eq-band input[type="range"] {
  writing-mode: vertical-lr;
  direction: rtl;
  width: 28px;
  height: 120px;
  accent-color: var(--accent);
  cursor: pointer;
}
.eq-gain {
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}
.eq-label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .4px;
  color: var(--dim);
}

</style>
</head>
<body>
<div id="app" role="application" aria-label="Sonara offline media hub"></div>
<script>
/* Sonara Media Hub — self-contained offline vault. No CDN required. */
(function () {
  "use strict";

  // Compact demo tone (C5, ~0.35s) — replaces the previous 200KB+ silent blob
  const DEMO_AUDIO = "data:audio/wav;base64,";

  const DEMO = {
    id: "demo",
    title: "Midnight Drive",
    artist: "Sonara Sessions",
    album: "Offline / Vol. 01",
    quality: "HIGH QUALITY",
    uri: DEMO_AUDIO,
    lyrics: ["City lights in the rearview", "Engine hums softly", "A quieter place to go"],
    demo: true,
    kind: "audio",
    mime: "audio/wav",
    size: 0,
    source: "bundled",
    favorite: false,
    tags: [],
    createdAt: 0,
    updatedAt: 0
  };

  const DB_NAME = "sonara-offline-media";
  const DB_VERSION = 2;
  let dbPromise = null;

  const state = {
    tab: "home",
    tracks: [{ ...DEMO }],
    recent: [],
    queue: ["demo"],
    current: "demo",
    videoId: null,
    query: "",
    filter: "all",
    sort: "recent",
    viewMode: "list",   // list | grid
    groupBy: "none",    // none | type | recent
    viewerId: null,
    collections: [],
    playing: false,
    shuffle: false,
    repeat: false,
    autoplay: true,
    modal: null,
    spotify: { connected: false, playlists: [] },
    theme: "dark",
    eq: {
      enabled: true,
      preset: "flat",
      bands: [
        { freq: 60, gain: 0, type: "lowshelf", label: "60" },
        { freq: 150, gain: 0, type: "peaking", label: "150" },
        { freq: 400, gain: 0, type: "peaking", label: "400" },
        { freq: 1000, gain: 0, type: "peaking", label: "1k" },
        { freq: 2400, gain: 0, type: "peaking", label: "2.4k" },
        { freq: 6000, gain: 0, type: "peaking", label: "6k" },
        { freq: 12000, gain: 0, type: "highshelf", label: "12k" }
      ]
    },
    subtitles: {}  // id -> vtt text
  };

  const $ = (s) => document.querySelector(s);
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[c]));

  function openDB() {
    if (dbPromise) return dbPromise;
    dbPromise = new Promise((resolve, reject) => {
      const req = indexedDB.open(DB_NAME, DB_VERSION);
      req.onupgradeneeded = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains("tracks")) db.createObjectStore("tracks", { keyPath: "id" });
        if (!db.objectStoreNames.contains("media")) db.createObjectStore("media", { keyPath: "id" });
        if (!db.objectStoreNames.contains("settings")) db.createObjectStore("settings", { keyPath: "key" });
      };
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
    return dbPromise;
  }

  async function idbGetAll(store) {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const req = db.transaction(store, "readonly").objectStore(store).getAll();
      req.onsuccess = () => resolve(req.result || []);
      req.onerror = () => reject(req.error);
    });
  }

  async function idbPutAll(store, items) {
    const db = await openDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(store, "readwrite");
      const os = tx.objectStore(store);
      items.forEach((x) => os.put(x));
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
  }

  function classifyMediaFile(file) {
    const t = (file.type || "").toLowerCase();
    const n = (file.name || "").toLowerCase();
    if (t.startsWith("audio/")) return "audio";
    if (t.startsWith("video/")) return "video";
    if (t.startsWith("image/")) return "image";
    if (t === "application/pdf" || /\.(pdf|txt|md|epub|rtf|doc|docx)$/i.test(n)) return "document";
    return "other";
  }

  function mediaIdentity(file) {
    return [file.name || "", file.size || 0, file.type || "", file.lastModified || 0].join("|");
  }

  function normalizeMedia(t) {
    const x = {
      ...t,
      kind: t.kind || ((t.mime || "").startsWith("video/") ? "video" : "audio"),
      mime: t.mime || t.type || "",
      size: t.size || t.blob?.size || 0,
      source: t.source || "local",
      favorite: !!t.favorite,
      tags: Array.isArray(t.tags) ? t.tags : [],
      createdAt: t.createdAt || Date.now(),
      updatedAt: t.updatedAt || Date.now()
    };
    if (x.blob && !x.uri) x.uri = URL.createObjectURL(x.blob);
    else if (x.demo) x.uri = DEMO_AUDIO;
    return x;
  }

  async function migrateLegacyRecords() {
    const media = await idbGetAll("media");
    if (media.length) {
      state.tracks = media.map(normalizeMedia);
      return;
    }
    const legacy = await idbGetAll("tracks");
    if (legacy.length) state.tracks = legacy.map(normalizeMedia);
    if (!state.tracks.length) {
      state.tracks = [normalizeMedia({ ...DEMO })];
    }
    await idbPutAll("media", state.tracks.map((t) => ({ ...t, uri: t.demo ? DEMO_AUDIO : "", blob: t.blob || null })));
  }

  async function load() {
    try {
      await migrateLegacyRecords();
      const settings = await idbGetAll("settings");
      const x = settings.find((v) => v.key === "state")?.value || {};
      if (Array.isArray(x.recent)) state.recent = x.recent;
      if (Array.isArray(x.queue)) state.queue = x.queue.filter((id) => state.tracks.some((t) => t.id === id && t.kind === "audio"));
      if (!state.queue.length) state.queue = state.tracks.filter((t) => t.kind === "audio").map((t) => t.id);
      if (x.current && state.tracks.some((t) => t.id === x.current)) state.current = x.current;
      if (x.videoId && state.tracks.some((t) => t.id === x.videoId && t.kind === "video")) state.videoId = x.videoId;
      if (typeof x.autoplay === "boolean") state.autoplay = x.autoplay;
      if (x.spotify) state.spotify = x.spotify;
      if (Array.isArray(x.collections)) state.collections = x.collections;
      if (x.subtitles) state.subtitles = x.subtitles;
      if (x.eq) state.eq = x.eq;
      if (x.theme) state.theme = x.theme;
    } catch (e) {
      console.warn("Sonara storage unavailable; using this-session mode.", e);
    }
  }

  async function save() {
    try {
      await idbPutAll("media", state.tracks.map((t) => ({ ...t, uri: t.demo ? DEMO_AUDIO : "", blob: t.blob || null })));
      await idbPutAll("settings", [{
        key: "state",
        value: {
          recent: state.recent,
          queue: state.queue,
          current: state.current,
          videoId: state.videoId,
          autoplay: state.autoplay,
          spotify: state.spotify,
          collections: state.collections, subtitles: state.subtitles, eq: state.eq, theme: state.theme
        }
      }]);
    } catch (e) {
      console.warn("Save failed", e);
    }
  }

  function formatBytes(n) {
    if (!n) return "0 B";
    const units = ["B", "KB", "MB", "GB"];
    const i = Math.min(Math.floor(Math.log(n) / Math.log(1024)), units.length - 1);
    return `${(n / 1024 ** i).toFixed(i ? 1 : 0)} ${units[i]}`;
  }

  function showToast(message, tone = "") {
    const old = document.querySelector(".toast");
    if (old) old.remove();
    const el = document.createElement("div");
    el.className = "toast " + tone;
    el.setAttribute("role", "status");
    el.setAttribute("aria-live", "polite");
    el.textContent = message;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 3200);
  }

  function track(id = state.current) {
    return state.tracks.find((t) => t.id === id) || DEMO;
  }

  function art(t, cls = "small") {
    const n = (t.title || "♪").trim()[0]?.toUpperCase() || "♪";
    let h = 20;
    for (const c of (t.title || "")) h = (h + c.charCodeAt(0) * 7) % 360;
    return `<div class="art ${cls}" style="background:hsl(${h} 28% 23%);color:hsl(${h} 70% 78%)" aria-hidden="true">${esc(n)}</div>`;
  }

  function pill(t, tone = "") {
    return `<span class="pill ${tone}">${esc(t)}</span>`;
  }

  function row(t) {
    const active = t.id === state.current && state.playing;
    return `<div class="row ${active ? "active" : ""}" data-play="${esc(t.id)}" role="button" tabindex="0">
      <button type="button" aria-label="Play ${esc(t.title)}">${art(t)}</button>
      <div class="copy">
        <div class="title">${esc(t.title)}</div>
        <div class="track-meta">${esc(t.artist)} · ${esc(t.album)}</div>
      </div>
      <div class="row-right">
        ${active ? '<span class="equal" aria-label="Now playing">•••</span>' : ""}
        ${pill(t.quality, t.quality === "LOSSLESS" ? "green" : "")}
        <button type="button" class="link" data-add="${esc(t.id)}" aria-label="Add to queue">＋</button>
      </div>
    </div>`;
  }

  function header(title, sub, action = "") {
    return `<div class="topline"><div><div class="brand">${title}<i>.</i></div><div class="eyebrow">${sub}</div></div>${action}</div>`;
  }

  function home() {
    const t = track();
    const recent = state.recent.map(track).filter(Boolean);
    const hasUserMedia = state.tracks.some((x) => !x.demo);
    const totalSize = state.tracks.reduce((a, x) => a + (x.size || 0), 0);
    const continueItems = (recent.length ? recent : [t]).slice(0, 3);

    return `
      <div class="home-top">
        <div class="home-title-row">
          <h1 class="home-title">Sonara</h1>
          <div class="home-actions">
            <button type="button" class="icon-btn" data-tab="library" aria-label="Search library">⌕</button>
            <button type="button" class="icon-btn" data-tab="library" aria-label="Open library">☰</button>
          </div>
        </div>
        <div class="home-sub">Private offline media · device only</div>
      </div>

      <div class="make-section">
        <div class="make-label">Make something new</div>
        <div class="make-grid">
          <button type="button" class="make-card make-audio" data-import>
            <div class="make-icon">♪</div>
            <div class="make-name">Audio</div>
            <span class="make-badge">New</span>
          </button>
          <button type="button" class="make-card make-video" data-import-video>
            <div class="make-icon">▶</div>
            <div class="make-name">Video</div>
            <span class="make-badge">New</span>
          </button>
          <button type="button" class="make-card make-files" data-import>
            <div class="make-icon">▦</div>
            <div class="make-name">Files</div>
          </button>
        </div>
      </div>

      <div class="continue-section">
        <div class="section-head">
          <div>
            <div class="eyebrow">Continue</div>
            <h2>${state.playing ? "Now playing" : "Recently played"}</h2>
          </div>
          <button type="button" class="link" data-tab="library">Library →</button>
        </div>

        <button type="button" class="continue-card" data-player>
          <div class="continue-art" style="background:hsl(${(t.title||'').split('').reduce((h,c)=>(h+c.charCodeAt(0)*7)%360,20)} 28% 22%)">${(t.title||'♪').trim()[0]?.toUpperCase()||'♪'}</div>
          <div class="continue-body">
            <div class="continue-title">${esc(t.title)}</div>
            <div class="continue-meta">${esc(t.artist)} · ${state.playing ? "Playing now" : "Ready offline"}</div>
          </div>
          <div class="continue-play" aria-hidden="true">${state.playing ? "Ⅱ" : "▶"}</div>
        </button>

        ${continueItems.length > 1 ? `
          <div class="continue-list">
            ${continueItems.slice(1).map((item) => `
              <button type="button" class="continue-row" data-play="${esc(item.id)}">
                <div class="continue-row-art">${(item.title||'♪').trim()[0]?.toUpperCase()||'♪'}</div>
                <div class="copy">
                  <div class="title">${esc(item.title)}</div>
                  <div class="track-meta">${esc(item.artist)}</div>
                </div>
              </button>
            `).join("")}
          </div>` : ""}
      </div>

      <div class="home-stats">
        <div class="home-stat"><strong>${state.tracks.length}</strong><span>Items</span></div>
        <div class="home-stat"><strong>${formatBytes(totalSize)}</strong><span>On device</span></div>
        <div class="home-stat"><strong>${recent.length}</strong><span>Recent</span></div>
      </div>

      <div class="home-foot">
        <p>Your files stay on this device. No account. No feed. No stream.</p>
      </div>`;
  }

  function typeLabel(k) {
    return ({ audio: "AUDIO", video: "VIDEO", image: "IMAGE", document: "DOC", other: "FILE", spotify: "SPOTIFY" })[k] || "FILE";
  }

  function filteredMediaRecords() {
    let list = state.tracks.filter((t) => {
      const q = state.query.toLowerCase().trim();
      const hay = [t.title, t.artist, t.album, t.name, (t.tags || []).join(" ")].join(" ").toLowerCase();
      if (q && !hay.includes(q)) return false;
      if (state.filter === "favorites" && !t.favorite) return false;
      if (state.filter === "recent" && !state.recent.includes(t.id)) return false;
      if (["audio", "video", "image", "document", "spotify"].includes(state.filter) && t.kind !== state.filter) return false;
      return true;
    });
    if (state.sort === "name") list.sort((a, b) => a.title.localeCompare(b.title));
    else if (state.sort === "size") list.sort((a, b) => (b.size || 0) - (a.size || 0));
    else list.sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0));
    return list;
  }

  function groupMedia(list) {
    if (state.groupBy === "none") return [{ key: "all", label: null, items: list }];
    if (state.groupBy === "type") {
      const order = ["audio", "video", "image", "document", "spotify", "other"];
      const map = {};
      list.forEach((t) => {
        const k = t.kind || "other";
        if (!map[k]) map[k] = [];
        map[k].push(t);
      });
      return order.filter((k) => map[k]?.length).map((k) => ({
        key: k,
        label: typeLabel(k),
        items: map[k]
      }));
    }
    // recent / favorites style groups
    const fav = list.filter((t) => t.favorite);
    const rec = list.filter((t) => state.recent.includes(t.id) && !t.favorite);
    const rest = list.filter((t) => !t.favorite && !state.recent.includes(t.id));
    const groups = [];
    if (fav.length) groups.push({ key: "favorites", label: "Favorites", items: fav });
    if (rec.length) groups.push({ key: "recent", label: "Recently played", items: rec });
    if (rest.length) groups.push({ key: "all", label: "Everything else", items: rest });
    return groups.length ? groups : [{ key: "all", label: null, items: list }];
  }

  function renderMediaCard(t) {
    const active = t.id === state.current && state.playing;
    const icon = t.kind === "video" ? "▶" : t.kind === "image" ? "▧" : t.kind === "document" ? "▤" : t.kind === "spotify" ? "♫" : "♪";
    if (state.viewMode === "grid") {
      return `<button type="button" class="grid-card ${active ? "active" : ""}" data-open-media="${esc(t.id)}" aria-label="Open ${esc(t.title)}">
        <div class="grid-art" style="background:hsl(${(t.title || "").split("").reduce((h,c)=>(h+c.charCodeAt(0)*7)%360,20)} 28% 22%)">${icon}</div>
        <div class="grid-title">${esc(t.title)}</div>
        <div class="grid-meta">${esc(t.artist || typeLabel(t.kind))}</div>
      </button>`;
    }
    return `<div class="row media-card ${active ? "active" : ""}" data-open-media="${esc(t.id)}" role="button" tabindex="0">
      <div class="playlist-icon" aria-hidden="true">${icon}</div>
      <div class="copy">
        <div class="media-type">${typeLabel(t.kind)}${t.favorite ? " · FAVORITE" : ""}</div>
        <div class="title">${esc(t.title)}</div>
        <div class="track-meta">${esc(t.artist || "Local file")} · ${esc(t.album || formatBytes(t.size || 0))}</div>
      </div>
      <div class="media-actions">
        <button type="button" class="link" data-favorite="${esc(t.id)}" aria-label="${t.favorite ? "Remove from" : "Add to"} favorites">${t.favorite ? "★" : "☆"}</button>
        <button type="button" class="link" data-open-media="${esc(t.id)}">OPEN</button>
      </div>
    </div>`;
  }

  function libraryEmpty() {
    return `<div class="lib-empty">
      <div class="lib-empty-inner">
        <h2>Your media,<br>offline.</h2>
        <p>Add songs, videos, images or documents from this device. They stay here and play without a connection.</p>
        <button type="button" class="primary" data-import>Add files</button>
      </div>
    </div>`;
  }

  function library() {
    const list = filteredMediaRecords();
    const groups = groupMedia(list);
    const counts = {
      all: state.tracks.length,
      audio: state.tracks.filter((x) => x.kind === "audio").length,
      video: state.tracks.filter((x) => x.kind === "video").length,
      image: state.tracks.filter((x) => x.kind === "image").length,
      document: state.tracks.filter((x) => x.kind === "document").length,
      spotify: state.tracks.filter((x) => x.kind === "spotify").length,
      favorites: state.tracks.filter((x) => x.favorite).length,
      recent: state.recent.length
    };
    const chips = [
      ["all", "All"],
      ["audio", "Audio"],
      ["video", "Video"],
      ["image", "Images"],
      ["document", "Docs"],
      ["favorites", "Favorites"],
      ["recent", "Recent"]
    ];
    const totalSize = state.tracks.reduce((a, x) => a + (x.size || 0), 0);
    const hasMedia = state.tracks.some((t) => !t.demo) || state.tracks.length > 1;

    return `
      ${header("Library", hasMedia ? `${state.tracks.length} items · ${formatBytes(totalSize)}` : "PRIVATE MEDIA VAULT",
        `<button type="button" class="primary" style="margin:0;padding:14px 16px;border-radius:14px;font-size:16px" data-import aria-label="Import media">＋</button>`)}
      
      <div class="lib-toolbar">
        <input class="search" value="${esc(state.query)}" placeholder="Search your library" aria-label="Search your library">
        <div class="lib-controls">
          <div class="media-filters" role="group" aria-label="Filter by type">
            ${chips.map(([id, label]) => `<button type="button" class="filter-chip ${state.filter === id ? "active" : ""}" data-filter="${id}" aria-pressed="${state.filter === id}">${label}${counts[id] != null ? " " + counts[id] : ""}</button>`).join("")}
          </div>
          <div class="lib-meta-row">
            <select class="lib-select" aria-label="Sort" data-sort>
              <option value="recent" ${state.sort === "recent" ? "selected" : ""}>Recent</option>
              <option value="name" ${state.sort === "name" ? "selected" : ""}>Name</option>
              <option value="size" ${state.sort === "size" ? "selected" : ""}>Size</option>
            </select>
            <select class="lib-select" aria-label="Group by" data-group>
              <option value="none" ${state.groupBy === "none" ? "selected" : ""}>No grouping</option>
              <option value="type" ${state.groupBy === "type" ? "selected" : ""}>By type</option>
              <option value="activity" ${state.groupBy === "activity" ? "selected" : ""}>Favorites & recent</option>
            </select>
            <div class="view-toggle" role="group" aria-label="View mode">
              <button type="button" class="view-btn ${state.viewMode === "list" ? "active" : ""}" data-view="list" aria-pressed="${state.viewMode === "list"}" aria-label="List view">☰</button>
              <button type="button" class="view-btn ${state.viewMode === "grid" ? "active" : ""}" data-view="grid" aria-pressed="${state.viewMode === "grid"}" aria-label="Grid view">▦</button>
            </div>
          </div>
        </div>
      </div>

      ${!hasMedia && !state.query && state.filter === "all" ? libraryEmpty() : `
        <div class="section-head">
          <div>
            <div class="eyebrow">YOUR LIBRARY</div>
            <h2>${list.length} result${list.length === 1 ? "" : "s"}</h2>
          </div>
        </div>
        ${list.length === 0 ? `
          <div class="empty">
            <h3>Nothing matches</h3>
            <p>Try a different search or filter. Your files stay on this device.</p>
            <button type="button" class="secondary" data-import>Add files</button>
          </div>` : groups.map((g) => `
            ${g.label ? `<div class="group-label">${esc(g.label)}</div>` : ""}
            <div class="${state.viewMode === "grid" ? "grid-list" : "media-list"}">
              ${g.items.map(renderMediaCard).join("")}
            </div>
          `).join("")}
      `}

      <div class="note">
        <b>LOCAL LIBRARY CONTRACT</b>
        <p>Files stay on this device until you reset the library or clear site data. Nothing is uploaded.</p>
      </div>`;
  }

  function openMedia(id) {
    const t = track(id);
    if (!t) return;
    if (t.kind === "audio") play(id);
    else if (t.kind === "spotify") {
      if (t.externalUrl) window.open(t.externalUrl, "_blank", "noopener,noreferrer");
    } else {
      state.viewerId = id;
      state.modal = "viewer";
      recordRecent(id);
      render();
    }
  }

  function library() {
    const list = filteredMediaRecords();
    const counts = {
      all: state.tracks.length,
      audio: state.tracks.filter((x) => x.kind === "audio").length,

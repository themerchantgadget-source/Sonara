        <p class="body">Videos play inline inside Sonara. Paste subtitles (SRT or VTT). Best support: mp4, webm, mov. MKV support depends on the browser.</p>
        <button type="button" class="primary" data-import-video style="margin-top:20px">Add video</button>
      </section>
      ${v ? `
        <div class="video-stage">
          <video id="ws-video" controls playsinline webkit-playsinline preload="metadata" src="${esc(v.uri)}"></video>
          <div class="video-caption-bar">
            <div class="title">${esc(v.title)}</div>
            <div class="track-meta">${formatBytes(v.size || 0)} · ${esc(v.mime || "video")}</div>
          </div>
        </div>
        <div class="form-row" style="margin-top:20px">
          <label for="subPaste">PASTE SUBTITLES (SRT OR VTT)</label>
          <textarea id="subPaste" class="sub-paste" rows="5" placeholder="1&#10;00:00:01,000 --> 00:00:04,000&#10;Hello from Sonara">${esc(subText)}</textarea>
          <div style="display:flex;gap:10px;margin-top:10px;flex-wrap:wrap">
            <button type="button" class="secondary" style="margin:0" data-apply-subs="${esc(v.id)}">Apply subtitles</button>
            <button type="button" class="link" data-clear-subs="${esc(v.id)}">Clear</button>
          </div>
        </div>
      ` : `<div class="empty" style="margin-top:24px"><h3>No videos yet</h3><p>Import mp4, mov, webm, or other video files. They play inline.</p><button type="button" class="secondary" data-import-video>Add video</button></div>`}
      <div class="section-head"><div><div class="eyebrow">VIDEO LIBRARY</div><h2>${list.length} file${list.length===1?"":"s"}</h2></div></div>
      ${list.map((x) => `
        <div class="row ${x.id===state.videoId?"active":""}" data-video="${esc(x.id)}" role="button" tabindex="0">
          <div class="playlist-icon">▶</div>
          <div class="copy"><div class="title">${esc(x.title)}</div><div class="track-meta">${formatBytes(x.size||0)}</div></div>
          <button type="button" class="link">OPEN</button>
        </div>`).join("")}
      <div class="note"><b>FORMAT NOTE</b><p>mp4 / webm / mov work best on iOS. MKV often fails in Safari — convert to mp4 when possible. Subtitles: paste SRT or VTT, then Apply.</p></div>`;
  }

  function photosWorkspace() {
    const list = tracksOf("image");
    return `
      ${header("Photos", "YOUR IMAGE VAULT")}
      <section class="settings-hero">
        <div class="eyebrow" style="color:var(--accent)">SANDBOXED WORKSPACE</div>
        <h2>Only photos live here.</h2>
        <p class="body">Browse images stored on this device. Tap to open the viewer.</p>
        <button type="button" class="primary" data-import style="margin-top:20px">Add images</button>
      </section>
      ${list.length ? `<div class="grid-list" style="margin-top:24px">${list.map(renderMediaCard).join("")}</div>` :
        `<div class="empty"><h3>No photos yet</h3><p>Import jpg, png, webp, heic, or other images.</p><button type="button" class="secondary" data-import>Add images</button></div>`}
      <div class="note"><b>PHOTOS CONTRACT</b><p>Images stay on device. Viewer opens in-app.</p></div>`;
  }

  function docsWorkspace() {
    const list = tracksOf("document");
    return `
      ${header("Documents", "READLE-STYLE LOCAL DOCS")}
      <section class="settings-hero">
        <div class="eyebrow" style="color:var(--accent)">SANDBOXED WORKSPACE</div>
        <h2>Only documents live here.</h2>
        <p class="body">PDFs and text files stored offline. Open in the in-app viewer or download.</p>
        <button type="button" class="primary" data-import style="margin-top:20px">Add documents</button>
      </section>
      ${list.length ? list.map(renderMediaCard).join("") :
        `<div class="empty"><h3>No documents yet</h3><p>Import pdf, txt, md, or other documents.</p><button type="button" class="secondary" data-import>Add documents</button></div>`}
      <div class="note"><b>DOCS CONTRACT</b><p>Files stay on this device. PDF opens in an embedded viewer when possible.</p></div>`;
  }

  function render() {
    const main = state.tab === "home" ? home()
      : state.tab === "library" ? library()
      : state.tab === "music" ? musicWorkspace()
      : state.tab === "video" ? videoWorkspace()
      : state.tab === "photos" ? photosWorkspace()
      : state.tab === "docs" ? docsWorkspace()
      : settings();
    $("#app").innerHTML = `
      <main class="app" id="main-content">${main}</main>
      <div class="bottom">${mini()}</div>
      ${state.modal === "player" ? player()
        : state.modal === "lyrics" ? lyrics()
        : state.modal === "viewer" && state.viewerId ? renderViewer(track(state.viewerId))
        : ""}`;
    bind();
    // Inline video + subtitles for Video workspace
    if (state.tab === "video" && state.videoId) {
      const v = document.getElementById("ws-video");
      if (v) attachSubtitles(v, state.videoId);
    }
  }

  function fmt(s) {
    if (!Number.isFinite(s) || s <= 0) return "0:00";
    s = Math.floor(s);
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  }

  const audio = new Audio();
  audio.preload = "auto";
  audio.src = DEMO_AUDIO;
  audio.crossOrigin = "anonymous";

  // —— Real-time equalizer (Web Audio API) ——
  let audioCtx = null;
  let mediaSource = null;
  let eqFilters = [];
  let eqReady = false;

  const EQ_PRESETS = {
    flat:      [0, 0, 0, 0, 0, 0, 0],
    bass:      [8, 5, 2, 0, 0, -1, -2],
    treble:    [-2, -1, 0, 1, 3, 6, 8],
    vocal:     [-3, -2, 1, 5, 4, 1, -1],
    electronic:[6, 4, 0, -2, 2, 5, 6],
    classical: [3, 2, 0, 0, -1, 2, 4],
    rock:      [5, 3, -1, 1, 3, 4, 3],
    soft:      [2, 1, 0, -1, -1, 1, 2]
  };

  function ensureEQ() {
    if (eqReady) return;
    try {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      mediaSource = audioCtx.createMediaElementSource(audio);
      eqFilters = state.eq.bands.map((b) => {
        const f = audioCtx.createBiquadFilter();
        f.type = b.type;
        f.frequency.value = b.freq;
        f.Q.value = b.type === "peaking" ? 1.0 : 0.7;
        f.gain.value = state.eq.enabled ? b.gain : 0;
        return f;
      });
      // chain: source -> f0 -> f1 -> ... -> destination
      let node = mediaSource;
      eqFilters.forEach((f) => {
        node.connect(f);
        node = f;
      });
      node.connect(audioCtx.destination);
      eqReady = true;
    } catch (e) {
      console.warn("EQ unavailable", e);
    }
  }

  function applyEQGains() {
    if (!eqReady || !eqFilters.length) return;
    state.eq.bands.forEach((b, i) => {
      if (eqFilters[i]) {
        const g = state.eq.enabled ? b.gain : 0;
        eqFilters[i].gain.setTargetAtTime(g, audioCtx.currentTime, 0.03);
      }
    });
  }

  function setEQPreset(name) {
    const gains = EQ_PRESETS[name] || EQ_PRESETS.flat;
    state.eq.preset = name;
    state.eq.bands.forEach((b, i) => { b.gain = gains[i] ?? 0; });
    applyEQGains();
    save();
    render();
  }

  function setEQBand(index, gain) {
    gain = Math.max(-12, Math.min(12, Number(gain) || 0));
    if (state.eq.bands[index]) {
      state.eq.bands[index].gain = gain;
      state.eq.preset = "custom";
      applyEQGains();
      save();
    }
  }

  function toggleEQ() {
    state.eq.enabled = !state.eq.enabled;
    applyEQGains();
    save();
    render();
  }

  function play(id = state.current) {
    const t = track(id);
    if (!t) return;
    state.current = t.id;
    if (t.kind === "spotify") {
      if (t.externalUrl) window.open(t.externalUrl, "_blank", "noopener,noreferrer");
      return;
    }
    if (t.kind !== "audio") return openMedia(t.id);
    if (!state.queue.includes(t.id)) state.queue.unshift(t.id);
    state.recent = [t.id, ...state.recent.filter((x) => x !== t.id)].slice(0, 30);
    t.updatedAt = Date.now();
    if (t.blob && !t.uri) t.uri = URL.createObjectURL(t.blob);
    audio.src = t.uri;
    ensureEQ();
    if (audioCtx && audioCtx.state === "suspended") audioCtx.resume();
    applyEQGains();
    audio.play().then(() => {
      state.playing = true;
      save();
      render();
    }).catch(() => {
      state.playing = false;
      render();
      showToast("Playback failed — try another file", "error");
    });
  }

  function toggle() {
    if (state.playing) {
      audio.pause();
      state.playing = false;
      render();
    } else play();
  }

  function next(dir = 1) {
    if (state.queue.length < 2) return;
    let i = state.queue.indexOf(state.current);
    let n = state.shuffle
      ? Math.floor(Math.random() * state.queue.length)
      : (i + dir + state.queue.length) % state.queue.length;
    play(state.queue[n]);
  }

  async function importMediaFiles(files) {
    const accepted = [...files];
    const result = { added: [], duplicates: [], unsupported: [], failed: [] };
    const existing = new Set(state.tracks.map((t) => t.identity).filter(Boolean));
    for (const file of accepted) {
      const kind = classifyMediaFile(file);
      if (kind === "other") {
        result.unsupported.push(file.name);
        continue;
      }
      if (file.size > 1024 * 1024 * 1024) {
        result.failed.push(file.name + ": file exceeds 1 GB safety limit");
        continue;
      }
      const identity = mediaIdentity(file);
      if (existing.has(identity) && !confirm(`${file.name} is already in Sonara. Import another copy?`)) {
        result.duplicates.push(file.name);
        continue;
      }
      try {
        const t = normalizeMedia({
          id: "local-" + Date.now() + Math.random().toString(16).slice(2),
          title: file.name.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " "),
          artist: "Imported locally",
          album: "Your device",
          quality: "LOCAL",
          mime: file.type,
          size: file.size,
          uri: URL.createObjectURL(file),
          blob: file,
          kind,
          identity,
          source: "local",
          favorite: false,
          tags: [],
          createdAt: Date.now(),
          updatedAt: Date.now(),
          lyrics: []
        });
        state.tracks.unshift(t);
        existing.add(identity);
        result.added.push(file.name);
        if (kind === "audio" && !state.queue.includes(t.id)) state.queue.push(t.id);
        if (kind === "video") state.videoId = t.id;
      } catch (e) {
        result.failed.push(file.name + ": " + e.message);
      }
    }
    await save();
    state.tab = "library";
    render();
    const total = result.added.length;
    if (total) showToast(`${total} media item${total === 1 ? "" : "s"} imported`);
    if (result.unsupported.length) showToast(`${result.unsupported.length} unsupported file${result.unsupported.length === 1 ? "" : "s"} skipped`, "error");
    if (result.failed.length) showToast(`${result.failed.length} import error${result.failed.length === 1 ? "" : "s"}`, "error");
    return result;
  }

  async function recordRecent(id) {
    state.recent = [id, ...state.recent.filter((x) => x !== id)].slice(0, 30);
    const t = track(id);
    if (t) t.updatedAt = Date.now();
    await save();
  }

  async function toggleFavorite(id) {
    const t = track(id);
    if (!t) return;
    t.favorite = !t.favorite;
    await save();
    render();
    showToast(t.favorite ? "Added to favorites" : "Removed from favorites");
  }

  async function createCollection(name) {
    name = (name || "").trim();
    if (!name) return;
    state.collections = state.collections || [];
    state.collections.push({ id: "collection-" + Date.now(), name, members: [], createdAt: Date.now() });
    await save();
    render();
    showToast("Collection created");
  }

  async function downloadLocalMedia(id) {
    const t = track(id);
    if (!t || !t.blob) return showToast("This item has no local file to download", "error");
    const a = document.createElement("a");
    a.href = t.uri || URL.createObjectURL(t.blob);
    a.download = t.title || "sonara-media";
    a.click();
  }

  async function clearMediaRecord(id) {
    if (!confirm("Remove this media item from Sonara?")) return;
    const t = track(id);
    if (t?.uri?.startsWith("blob:")) URL.revokeObjectURL(t.uri);
    state.tracks = state.tracks.filter((x) => x.id !== id);
    state.queue = state.queue.filter((x) => x !== id);
    state.recent = state.recent.filter((x) => x !== id);
    if (state.current === id) state.current = state.tracks.find((x) => x.kind === "audio")?.id || "demo";
    if (state.viewerId === id) {
      state.viewerId = null;
      state.modal = null;
    }
    await save();
    render();
    showToast("Media removed");
  }

  async function resetLocalLibrary() {
    if (!confirm("Reset your entire local Sonara media library?")) return;
    state.tracks.forEach((t) => {
      if (t.uri?.startsWith("blob:")) URL.revokeObjectURL(t.uri);
    });
    const db = await openDB();
    await new Promise((resolve, reject) => {
      const tx = db.transaction(["media", "tracks", "settings"], "readwrite");
      tx.objectStore("media").clear();
      tx.objectStore("tracks").clear();
      tx.objectStore("settings").clear();
      tx.oncomplete = () => resolve();
      tx.onerror = () => reject(tx.error);
    });
    state.tracks = [normalizeMedia({ ...DEMO })];
    state.queue = ["demo"];
    state.recent = [];
    state.collections = [];
    state.current = "demo";
    state.videoId = null;
    state.viewerId = null;
    state.modal = null;
    await save();
    render();
    showToast("Local library reset");
  }

  function bind() {
    document.querySelectorAll("[data-create-collection]").forEach((b) => (b.onclick = () => createCollection($("#collectionName")?.value || "")));
    document.querySelectorAll("[data-filter]").forEach((b) => (b.onclick = () => { state.filter = b.dataset.filter; render(); }));
    document.querySelectorAll("[data-view]").forEach((b) => (b.onclick = () => { state.viewMode = b.dataset.view; render(); }));
    document.querySelectorAll("[data-sort]").forEach((s) => (s.onchange = (e) => { state.sort = e.target.value; render(); }));
    document.querySelectorAll("[data-group]").forEach((s) => (s.onchange = (e) => { state.groupBy = e.target.value; render(); }));
    document.querySelectorAll("[data-open-media]").forEach((b) => (b.onclick = (e) => {
      if (e.target.closest("[data-favorite]")) return;
      openMedia(b.dataset.openMedia);
    }));
    document.querySelectorAll("[data-favorite]").forEach((b) => (b.onclick = (e) => {
      e.stopPropagation();
      toggleFavorite(b.dataset.favorite);
    }));
    document.querySelectorAll("[data-download]").forEach((b) => (b.onclick = () => downloadLocalMedia(b.dataset.download)));
    document.querySelectorAll("[data-remove]").forEach((b) => (b.onclick = () => clearMediaRecord(b.dataset.remove)));
    document.querySelectorAll("[data-spotify-connect]").forEach((b) => (b.onclick = () => spotifyConnect().catch((e) => alert(e.message))));
    document.querySelectorAll("[data-spotify-refresh]").forEach((b) => (b.onclick = () => spotifyLoadPlaylists().then(render).catch((e) => alert(e.message))));
    document.querySelectorAll("[data-spotify-import]").forEach((b) => (b.onclick = () => spotifyImportPlaylist(b.dataset.spotifyImport).catch((e) => alert(e.message))));
    document.querySelectorAll("[data-tab]").forEach((b) => (b.onclick = () => { state.tab = b.dataset.tab; state.modal = null; render(); }));
    document.querySelectorAll("[data-play]").forEach((b) => (b.onclick = () => play(b.dataset.play)));
    document.querySelectorAll("[data-add]").forEach((b) => (b.onclick = (e) => {
      e.stopPropagation();
      if (!state.queue.includes(b.dataset.add)) state.queue.push(b.dataset.add);
      save();
      render();
      showToast("Added to queue");
    }));
    document.querySelectorAll("[data-import]").forEach((b) => (b.onclick = () => {
      const i = document.createElement("input");
      i.type = "file";
      i.accept = "audio/*,video/*,image/*,.pdf,.txt,.md,.epub,.rtf,.doc,.docx,.mkv,.mp4,.webm,.mov,.mp3,.wav,.m4a,.flac,.ogg,.aac,.webp,.heic,.jpg,.jpeg,.png";
      i.multiple = true;
      i.onchange = () => importMediaFiles(i.files);
      i.click();
    }));
    document.querySelectorAll("[data-import-video]").forEach((b) => (b.onclick = () => {
      const i = document.createElement("input");
      i.type = "file";
      i.accept = "video/*,.mkv,.mp4,.webm,.mov,.m4v";
      i.multiple = true;
      i.onchange = () => importMediaFiles(i.files);
      i.click();
    }));
    document.querySelectorAll("[data-video]").forEach((b) => (b.onclick = () => { state.videoId = b.dataset.video; save(); render(); }));
    document.querySelectorAll("[data-player]").forEach((b) => (b.onclick = () => { state.modal = "player"; render(); }));
    document.querySelectorAll("[data-close]").forEach((b) => (b.onclick = () => { state.modal = null; state.viewerId = null; render(); }));
    // sort / group / view handled via data- attributes
    document.querySelectorAll("[data-toggle]").forEach((b) => (b.onclick = toggle));
    document.querySelectorAll("[data-next]").forEach((b) => (b.onclick = () => next(1)));
    document.querySelectorAll("[data-prev]").forEach((b) => (b.onclick = () => next(-1)));
    document.querySelectorAll("[data-seek]").forEach((b) => (b.onclick = () => {
      audio.currentTime = Math.max(0, Math.min(audio.duration || 0, audio.currentTime + Number(b.dataset.seek)));
      render();
    }));
    document.querySelectorAll("[data-shuffle]").forEach((b) => (b.onclick = () => { state.shuffle = !state.shuffle; render(); }));
    document.querySelectorAll("[data-repeat]").forEach((b) => (b.onclick = () => { state.repeat = !state.repeat; audio.loop = state.repeat; render(); }));
    document.querySelectorAll("[data-lyrics]").forEach((b) => (b.onclick = () => { state.modal = "lyrics"; render(); }));
    
    document.querySelectorAll("[data-eq-toggle]").forEach((b) => (b.onclick = () => toggleEQ()));
    document.querySelectorAll("[data-eq-preset]").forEach((b) => (b.onclick = () => {
      const name = b.dataset.eqPreset;
      if (name === "custom") return;
      setEQPreset(name);
    }));
    document.querySelectorAll("[data-eq-band]").forEach((input) => {
      input.oninput = (e) => {
        const i = Number(input.dataset.eqBand);
        setEQBand(i, e.target.value);
        // live update label without full re-render for smoothness
        const gainEl = input.parentElement.querySelector(".eq-gain");
        if (gainEl) {
          const g = Number(e.target.value);
          gainEl.textContent = (g > 0 ? "+" : "") + g;
        }
      };
      input.onchange = () => render();
    });
    document.querySelectorAll("[data-autoplay]").forEach((b) => (b.onclick = () => { state.autoplay = !state.autoplay; save(); render(); }));
    document.querySelectorAll("[data-reset]").forEach((b) => (b.onclick = resetLocalLibrary));
    const search = $(".search");
    if (search && search.placeholder === "Search all local media") {
      search.oninput = (e) => {
        state.query = e.target.value;
        render();
        const s = $(".search");
        if (s) {
          s.focus();
          s.setSelectionRange(state.query.length, state.query.length);
        }
      };
    }
  }

  // Keyboard shortcuts
  document.addEventListener("keydown", (e) => {
    if (e.target.matches("input, textarea, select")) return;
    if (e.code === "Space") {
      e.preventDefault();
      toggle();
    } else if (e.code === "ArrowRight") next(1);
    else if (e.code === "ArrowLeft") next(-1);
    else if (e.code === "Escape" && state.modal) {
      state.modal = null;
      state.viewerId = null;
      render();
    }
  });

  audio.onplay = () => { state.playing = true; };
  audio.onpause = () => { state.playing = false; };
  audio.ontimeupdate = () => {
    if (state.modal === "player") {
      const p = document.querySelector(".progress i");
      const t = document.querySelector(".time");
      if (p) p.style.width = `${audio.duration ? Math.min(100, (audio.currentTime / audio.duration) * 100) : 0}%`;
      if (t) t.innerHTML = `<span>${fmt(audio.currentTime)}</span><span>${fmt(audio.duration)}</span>`;
    }
  };
  audio.onended = () => {
    if (state.repeat) {
      audio.currentTime = 0;
      audio.play();
    } else if (state.autoplay) next(1);
  };

  // Boot
  render();
  load()
    .then(() => spotifyCallback().catch((e) => console.warn(e)))
    .then(render)
    .catch(() => render());
})();
</script>
</body>
</html>

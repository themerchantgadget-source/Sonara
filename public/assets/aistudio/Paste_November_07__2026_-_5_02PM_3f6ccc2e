  // Spotify helpers (session-only tokens; config kept in memory for this session)
  let spotifyConfigMem = { clientId: "", redirectUri: "" };

  function randomVerifier(n = 64) {
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";
    const a = crypto.getRandomValues(new Uint8Array(n));
    return [...a].map((x) => chars[x % chars.length]).join("");
  }

  async function challenge(v) {
    const hash = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(v));
    return btoa(String.fromCharCode(...new Uint8Array(hash))).replace(/=/g, "").replace(/\+/g, "-").replace(/\//g, "_");
  }

  function spotifyRedirect() {
    return $("#spotifyRedirect")?.value.trim() || spotifyConfigMem.redirectUri || location.href.split("?")[0].split("#")[0];
  }

  async function spotifyConnect() {
    const clientId = $("#spotifyClientId")?.value.trim();
    const redirectUri = spotifyRedirect();
    if (!clientId || !redirectUri) return alert("Enter your Spotify Client ID and exact registered redirect URI.");
    if (location.protocol === "file:") return alert("Spotify OAuth cannot return to a file:// page. Host this HTML at HTTPS or localhost.");
    const verifier = randomVerifier();
    const stateToken = randomVerifier(32);
    const codeChallenge = await challenge(verifier);
    spotifyConfigMem = { clientId, redirectUri };
    // Use sessionStorage only for the short-lived PKCE handshake
    try {
      sessionStorage.setItem("sonara-spotify-pkce", JSON.stringify({ verifier, state: stateToken, clientId, redirectUri }));
    } catch (_) {}
    const u = new URL("https://accounts.spotify.com/authorize");
    u.search = new URLSearchParams({
      client_id: clientId,
      response_type: "code",
      redirect_uri: redirectUri,
      scope: "playlist-read-private playlist-read-collaborative user-read-private",
      state: stateToken,
      code_challenge_method: "S256",
      code_challenge: codeChallenge
    }).toString();
    location.href = u;
  }

  async function spotifyCallback() {
    const p = new URLSearchParams(location.search);
    const code = p.get("code");
    const returnedState = p.get("state");
    if (!code) return;
    let saved = null;
    try { saved = JSON.parse(sessionStorage.getItem("sonara-spotify-pkce") || "null"); } catch (_) {}
    if (!saved || returnedState !== saved.state) return;
    const r = await fetch("https://accounts.spotify.com/api/token", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        client_id: saved.clientId,
        grant_type: "authorization_code",
        code,
        redirect_uri: saved.redirectUri,
        code_verifier: saved.verifier
      })
    });
    if (!r.ok) throw new Error("Spotify token exchange failed");
    const token = await r.json();
    try {
      sessionStorage.setItem("sonara-spotify-token", JSON.stringify({ access_token: token.access_token, expires_at: Date.now() + token.expires_in * 1000 }));
    } catch (_) {}
    history.replaceState({}, "", saved.redirectUri);
    state.spotify.connected = true;
    await spotifyLoadPlaylists();
  }

  async function spotifyApi(path) {
    let token = null;
    try { token = JSON.parse(sessionStorage.getItem("sonara-spotify-token") || "null"); } catch (_) {}
    if (!token || token.expires_at < Date.now()) throw new Error("Spotify connection expired; reconnect.");
    const r = await fetch("https://api.spotify.com/v1" + path, { headers: { Authorization: "Bearer " + token.access_token } });
    if (!r.ok) throw new Error("Spotify API request failed");
    return r.json();
  }

  async function spotifyLoadPlaylists() {
    const data = await spotifyApi("/me/playlists?limit=50");
    state.spotify.playlists = data.items || [];

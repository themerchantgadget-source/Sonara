  async function spotifyImportPlaylist(id) {
    const data = await spotifyApi("/playlists/" + encodeURIComponent(id) + "/items?limit=50");
    let count = 0;
    for (const item of data.items || []) {
      const t = item.item || item.track;
      if (!t || t.type !== "track") continue;
      const rid = "spotify-" + t.id;
      if (state.tracks.some((x) => x.id === rid)) continue;
      state.tracks.unshift({
        id: rid,
        title: t.name,
        artist: (t.artists || []).map((a) => a.name).join(", "),
        album: t.album?.name || "Spotify",
        quality: "SPOTIFY",
        kind: "spotify",
        mime: "",
        size: 0,
        source: "spotify",
        externalUrl: t.external_urls?.spotify || "",
        favorite: false,
        tags: [],
        lyrics: [],
        createdAt: Date.now(),
        updatedAt: Date.now()
      });
      count++;
    }
    await save();
    render();
    showToast(`${count} Spotify metadata item${count === 1 ? "" : "s"} imported`);
  }


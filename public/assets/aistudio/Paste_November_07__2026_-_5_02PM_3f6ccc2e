  function srtToVtt(srt) {
    let t = String(srt || "").replace(/\r/g, "").trim();
    if (!t) return "";
    if (!t.startsWith("WEBVTT")) t = "WEBVTT\n\n" + t;
    // SRT uses comma for ms, VTT uses period
    t = t.replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, "$1.$2");
    return t;
  }

  function attachSubtitles(videoEl, trackId) {
    if (!videoEl) return;
    // clear existing tracks
    [...videoEl.querySelectorAll("track")].forEach((tr) => tr.remove());
    const text = state.subtitles[trackId];
    if (!text) return;
    const vtt = srtToVtt(text);
    const blob = new Blob([vtt], { type: "text/vtt" });
    const url = URL.createObjectURL(blob);
    const track = document.createElement("track");
    track.kind = "subtitles";
    track.label = "Subtitles";
    track.srclang = "en";
    track.src = url;
    track.default = true;
    videoEl.appendChild(track);
    // show
    setTimeout(() => {
      if (videoEl.textTracks && videoEl.textTracks[0]) videoEl.textTracks[0].mode = "showing";
    }, 100);
  }

